      </div>
    </div>
  </aside>
</div>

<script type="application/json" id="data">[{"n": 1, "stem": "A newly formed development team experienced difficulty with accurately estimating product backlog items. As a result, the team failed to deliver all of the features in the sprint backlog for the past two iterations.\nWhat should the team do to improve the accuracy of their estimates?", "opts": {"A": "Decrease the sprint time box until the team is able to deliver the entire agreed-upon sprint backlog in a single sprint", "B": "Discuss estimating techniques in the daily scrum meeting", "C": "Increase the size of the development team until the team is able to deliver the entire agreed-upon sprint backlog in a single sprint", "D": "Begin tracking estimated effort metrics as an input to performance evaluation"}, "a": "A", "th": "Team mới thành lập ước lượng không chính xác nên 2 iteration liên tiếp không giao hết sprint backlog. Cần làm gì để ước lượng chính xác hơn?", "dung": "Rút ngắn sprint (time box) giúp team có vòng phản hồi nhanh hơn: sprint ngắn → lượng việc ít hơn → dễ ước lượng hơn, và team được \"luyện\" ước lượng nhiều lần hơn trong cùng một khoảng thời gian. Khi đã giao được trọn vẹn và velocity ổn định thì có thể nới sprint ra lại. Đây là cách điều chỉnh mang tính thực nghiệm (inspect & adapt).", "sai": {"B": "Daily scrum chỉ 15 phút để đồng bộ tiến độ và nêu trở ngại, không phải nơi thảo luận kỹ thuật ước lượng. (Nếu muốn bàn cách ước lượng thì Retrospective hợp lý hơn — nhưng không có đáp án đó.)", "C": "Tăng người không giải quyết gốc rễ (ước lượng sai), còn làm tăng chi phí giao tiếp (Brooks' law).", "D": "Dùng số liệu ước lượng để đánh giá hiệu suất cá nhân khiến mọi người \"độn\" số, phá vỡ sự minh bạch."}, "meo": "Team mới, ước lượng sai liên tục → sprint ngắn lại để nhận feedback nhanh.", "note": "Trong file có ghi chú phương án B. Đáp án phổ biến của bộ đề này là A; nếu đề có phương án \"thảo luận ở retrospective\" thì đó mới là lựa chọn tốt nhất."}, {"n": 2, "stem": "Midway through a sprint, the scrum master identifies that reassigning a certain task could help the team meet its sprint's goals.\nWhat should the scrum master do next?", "opts": {"A": "Alert the team that sprint goals might not be met and create an alternative plan", "B": "Obtain team buy-in to perform modifications to the sprint backlog", "C": "Have the sprint proceed as planned", "D": "Ask the team to decide if the task should be reassigned"}, "a": "D", "th": "Giữa sprint, Scrum Master thấy nếu giao lại (reassign) một task thì team có thể đạt sprint goal. SM nên làm gì?", "dung": "Team Scrum tự tổ chức (self-organizing): việc ai làm task nào là quyết định của Development Team, không phải của SM. SM là servant leader — chỉ nêu quan sát và để team tự quyết.", "sai": {"A": "Báo động \"có thể không đạt goal\" và tự lập kế hoạch thay thế là SM làm thay team.", "B": "\"Xin team đồng ý\" để SM tự sửa sprint backlog vẫn là SM ra quyết định, team chỉ gật đầu.", "C": "Lờ đi cơ hội cải thiện, trái với tinh thần inspect & adapt."}, "meo": "Câu hỏi \"ai phân công task?\" → luôn là TEAM tự quyết.", "note": "Trong file, cột đáp án ghi C nhưng cột bên cạnh ghi D. Theo nguyên tắc self-organizing, D là đáp án hợp lý nhất."}, {"n": 3, "stem": "During the iteration planning of a newly on boarded agile team, the product owner adds a set of high priority user stories into the iteration backlog.\nWhat should the team do first to define the tasks need to implement the user stories?", "opts": {"A": "Self-organize", "B": "Assign tasks to each team member", "C": "Meet with the customer", "D": "Identify the scrum master"}, "a": "A", "th": "Team agile mới, PO đưa các user story ưu tiên cao vào iteration backlog. Việc ĐẦU TIÊN để xác định các task cần làm là gì?", "dung": "Team tự tổ chức (self-organize): cùng nhau chia story thành task, tự nhận việc. Đây là bước đầu tiên và là nguyên tắc cốt lõi.", "sai": {"B": "Giao task cho từng người là kiểu quản lý mệnh lệnh (command & control).", "C": "Gặp khách hàng không phải bước đầu để chia task; PO đại diện khách hàng rồi.", "D": "Xác định SM không liên quan đến việc chia task."}, "meo": "\"First\" + team mới + chia task → Self-organize.", "note": ""}, {"n": 4, "stem": "A project's first iteration contains item A, and its second iteration contains item B. The first iteration is behind schedule, which will impact the second iteration.\nSince items A and B are similar, a team member suggests beginning the design of item B.\nWhat should the agile practitioner do?", "opts": {"A": "Defer starting the design of item B until the second iteration is being planned", "B": "Proceed with the design of item B, since it will hasten the second iteration", "C": "Escalate the issue to the customer, and obtain their approval before starting the design of item B", "D": "Log the issue in the risk register, and request change control board (CCB) approval."}, "a": "A", "th": "Iteration 1 có item A, iteration 2 có item B. Iteration 1 đang trễ. Vì A và B giống nhau, một thành viên đề nghị bắt đầu thiết kế B luôn.", "dung": "Theo Lean, làm trước những việc chưa được lên kế hoạch là lãng phí (có thể bị đổi ưu tiên, làm phân tán sự tập trung khi iteration hiện tại đang trễ). Hãy tập trung hoàn thành A, để việc thiết kế B vào lúc lập kế hoạch iteration 2 (\"trì hoãn đến thời điểm hợp lý cuối cùng\" - last responsible moment).", "sai": {"B": "Làm B khi A đang trễ chỉ khiến A trễ thêm; tăng WIP.", "C": "Không cần leo thang lên khách hàng cho chuyện nội bộ team.", "D": "CCB (Change Control Board) là công cụ của mô hình truyền thống, không phải agile."}, "meo": "LEAN = không lãng phí, tập trung vào việc hiện tại, giảm WIP.", "note": ""}, {"n": 5, "stem": "An Agile team is under pressure to deliver an application. The product owner anticipates many change requests from customers once the product is released.\nWhat should the agile team do?", "opts": {"A": "Demand frequent product reviews by the product owner", "B": "Continuously work with the product owner to do backlog refinement and product reviews", "C": "Have the product owner provide detailed requirement specifications to ensure the proper features are delivered", "D": "During the planning session, ensure the team is committed to deliver within the specifications"}, "a": "B", "th": "Team đang chịu áp lực giao app. PO dự đoán (anticipates) sẽ có nhiều yêu cầu thay đổi từ khách sau khi phát hành.", "dung": "Agile chào đón thay đổi. Cách tốt nhất là làm việc liên tục với PO: refine backlog thường xuyên và review sản phẩm, để thay đổi được đưa vào sớm, đúng thứ tự ưu tiên.", "sai": {"A": "\"Đòi hỏi\" PO review thường xuyên mang tính áp đặt, không phải cộng tác.", "C": "Spec chi tiết từ đầu là cách waterfall; không ngăn được thay đổi.", "D": "Cam kết làm đúng spec đi ngược lại việc chấp nhận thay đổi."}, "meo": "Có nhiều thay đổi → backlog refinement liên tục + review cùng PO.", "note": ""}, {"n": 6, "stem": "During iteration planning, it was determined that an epic should be decomposed.\nWhat was the determining factor?", "opts": {"A": "Size and priority", "B": "Minimum marketable features", "C": "Release plan", "D": "Sprint mapping"}, "a": "A", "th": "Trong iteration planning, team quyết định phải chia nhỏ (decompose) một epic. Yếu tố quyết định là gì?", "dung": "Epic được chia nhỏ khi nó quá lớn để làm trong một iteration (size) VÀ đang đủ ưu tiên để sắp được làm (priority). Epic ưu tiên thấp thì chưa cần chia vội.", "sai": {"B": "MMF là một cách nhóm tính năng có giá trị thị trường, không phải tiêu chí để chia epic.", "C": "Release plan là kết quả của việc lập kế hoạch, không phải lý do chia epic.", "D": "\"Sprint mapping\" không phải khái niệm chuẩn."}, "meo": "Chia epic khi: TO + SẮP LÀM (size & priority).", "note": ""}, {"n": 7, "stem": "What should a scrum master do when one team member falls behind in their tasks?", "opts": {"A": "Move the task to another team member who has spare capacity in the sprint", "B": "Ask the team for suggestions", "C": "Privately offer the team member encouragement to meet task commitments", "D": "Notify the product owner"}, "a": "B", "th": "Một thành viên bị trễ task. Scrum Master nên làm gì?", "dung": "SM tạo điều kiện để TEAM cùng giải quyết. Hỏi ý kiến team giúp phát huy tinh thần tự tổ chức và trách nhiệm tập thể — có thể ai đó rảnh sẽ hỗ trợ (swarming), hoặc team tìm ra trở ngại.", "sai": {"A": "SM tự chuyển task cho người khác là phân công thay team.", "C": "Động viên riêng là tốt nhưng chỉ dồn áp lực lên một người, không giải quyết ở cấp team.", "D": "Báo PO quá sớm; việc nội bộ team nên để team xử lý trước."}, "meo": "Vấn đề trong team → hỏi TEAM trước.", "note": "File ghi đáp án C, cột bên cạnh ghi B. Theo tinh thần self-organizing, B hợp lý hơn; một số bộ đề chọn C với lập luận SM hỗ trợ cá nhân một cách riêng tư."}, {"n": 8, "stem": "A newly formed scrum team wants to foster an environment for transparency and experimentation. The team decides to use a Kanban board to record and track encountered impediments. Emphasis is placed on how issues are resolved and the strategies for preventing them in the future.\nOver time, what will be the result of this approach?", "opts": {"A": "Kaizen", "B": "Specific, measurable, assignable, realistic, and time-based (SMART) goals", "C": "Key performance indicators (KPIs)", "D": "Muda"}, "a": "A", "th": "Team scrum mới muốn tạo môi trường minh bạch và thử nghiệm, dùng Kanban board để ghi lại trở ngại, tập trung vào cách giải quyết và cách phòng tránh trong tương lai. Lâu dài sẽ có kết quả gì?", "dung": "Kaizen = cải tiến liên tục, từng bước nhỏ. Việc ghi nhận vấn đề, phân tích cách giải quyết và phòng ngừa chính là vòng lặp cải tiến liên tục.", "sai": {"B": "SMART là cách đặt mục tiêu, không phải kết quả của quá trình này.", "C": "KPI là chỉ số đo lường, không phải kết quả.", "D": "Muda nghĩa là \"lãng phí\" trong Lean — ngược nghĩa."}, "meo": "Cải tiến liên tục = Kaizen; lãng phí = Muda.", "note": ""}, {"n": 9, "stem": "A mature agile team welcomes a new member. Due to poor experiences with a previous team, the new member is reluctant to communicate.\nWhat should be the agile project leader do?", "opts": {"A": "Bring up the new member's impediments at the next meeting to demonstrate team support of input", "B": "Assure the new member that inputs on impediments are valued, and demonstrate this at the next meeting", "C": "Have a senior leader work with the new member to avoid a negative impact on team productivity", "D": "Privately work with the new member to address any impediments"}, "a": "B", "th": "Team agile trưởng thành có thành viên mới, do trải nghiệm xấu ở team cũ nên ngại (reluctant) giao tiếp.", "dung": "Leader cần tạo sự an toàn tâm lý: trấn an rằng ý kiến về trở ngại được coi trọng VÀ chứng minh (demonstrate) điều đó bằng hành động tại cuộc họp tới. Lời nói + hành động → xây dựng niềm tin.", "sai": {"A": "Tự đem trở ngại của người mới ra họp có thể khiến họ càng ngại.", "C": "Giao cho senior leader kèm vì sợ ảnh hưởng năng suất — tập trung vào năng suất hơn con người.", "D": "Xử lý riêng không giúp họ hòa nhập và giao tiếp với team."}, "meo": "Người ngại nói → trấn an + chứng minh bằng hành động.", "note": ""}, {"n": 10, "stem": "During a sprint, the team encounters a technical problem that becomes an impediment to completing two stories.\nWhat should the scrum master do?", "opts": {"A": "Ask the lead developer to identify a solution, and then share the details with the team", "B": "Ask a technical manager or architect to determine a solution to the problem", "C": "Work with the product owner to add a spike to the next sprint to identify a solution", "D": "Create a collaborative team environment so that the team can explore a solution together"}, "a": "D", "th": "Trong sprint, team gặp (encounter) một vấn đề kỹ thuật cản trở việc hoàn thành 2 story.", "dung": "SM tạo môi trường cộng tác để team cùng tìm giải pháp. Team tự tổ chức và có chuyên môn kỹ thuật, nên tự giải quyết là tốt nhất.", "sai": {"A": "Dồn trách nhiệm cho một người (lead dev) làm mất tính tập thể.", "B": "Nhờ quản lý/kiến trúc sư bên ngoài trước khi team thử là sai thứ tự.", "C": "Đẩy spike sang sprint sau trong khi vấn đề đang chặn sprint hiện tại."}, "meo": "Vấn đề kỹ thuật → team cùng giải quyết.", "note": ""}, {"n": 11, "stem": "A new team member asks what changes could accelerate a change to the project plan.\nWhat should be the proper response?", "opts": {"A": "Competitors joined forces with the team", "B": "The customer changed requirements", "C": "Project team members obtained additional certifications", "D": "Technology which did not interfere with the final product"}, "a": "B", "th": "Thành viên mới hỏi thay đổi nào có thể làm cho kế hoạch dự án phải thay đổi nhanh.", "dung": "Thay đổi yêu cầu từ khách hàng là nguyên nhân phổ biến và chính đáng nhất khiến kế hoạch agile thay đổi. Agile chủ động đón nhận việc này.", "sai": {"A": "Đối thủ hợp tác với team — tình huống hiếm, không liên quan trực tiếp.", "C": "Thành viên có thêm chứng chỉ không làm thay đổi kế hoạch.", "D": "Công nghệ không ảnh hưởng sản phẩm thì không cần đổi kế hoạch."}, "meo": "Kế hoạch agile thay đổi chủ yếu vì yêu cầu của khách hàng.", "note": ""}, {"n": 12, "stem": "Midway through an iteration, an agile team learns that a team member will be unavailable for the next two iterations.\nAs a high-performance team, what should the team do?", "opts": {"A": "Raise an impediment that resource tasks will be blocked and notify the product owner", "B": "Ask the delivery manager for a temporary resource", "C": "Ask the scrum master to assign that team member's tasks to the next available resource", "D": "Assume the team member's tasks to meet iteration goals, and notify the product owner"}, "a": "D", "th": "Giữa iteration, team biết một thành viên vắng mặt trong 2 iteration tới. Là team hiệu suất cao, nên làm gì?", "dung": "Team hiệu suất cao tự gánh phần việc của người vắng (cross-functional, tự tổ chức) để đạt iteration goal, đồng thời minh bạch thông báo cho PO.", "sai": {"A": "Chỉ báo trở ngại mà không hành động — không phải team hiệu suất cao.", "B": "Xin người tạm thời mất thời gian onboarding, không hiệu quả trong ngắn hạn.", "C": "Để SM phân công là trái nguyên tắc tự tổ chức."}, "meo": "\"High-performance team\" → tự xử lý + minh bạch với PO.", "note": ""}, {"n": 13, "stem": "An agile practitioner wants to ensure that stakeholders have current information about a project's progress.\nWhat should the agile practitioner do?", "opts": {"A": "Regularly circulate an updated, detailed version of the project plan", "B": "Frequently update the online project management office (PMO) repository site", "C": "Invite the stakeholders to daily stand ups", "D": "Post a project board in an area where all can view it"}, "a": "D", "th": "Muốn stakeholder luôn có thông tin hiện tại về tiến độ dự án.", "dung": "Đặt project board (information radiator) ở nơi ai cũng nhìn thấy — thông tin luôn cập nhật, tự động \"tỏa\" ra, không cần gửi báo cáo.", "sai": {"A": "Gửi bản kế hoạch chi tiết là cách truyền thống, tốn công và nhanh lỗi thời.", "B": "Kho PMO online là thông tin \"kéo\", người ta phải tự vào xem.", "C": "Daily stand-up dành cho team, mời stakeholder sẽ làm loãng mục đích."}, "meo": "Thông tin tiến độ cho mọi người → Information radiator.", "note": ""}, {"n": 14, "stem": "A company has decided to combine two similar products consisting of multiple teams into one product. Engaged customers want to know how the company is looking at re-organizing its teams.\nWhat strategy should be employed to re-organize the teams?", "opts": {"A": "All the teams from both products should be simultaneously called together and allowed to completely self-manage", "B": "Teams that worked on similar components in the separate products should be combined to minimize disruption and capitalize on synergies", "C": "After grouping individuals by role, multi-discipline teams should be created that are comprised of one member from each role", "D": "Features should be prioritized and then teams should be organized around those priorities"}, "a": "A", "th": "Công ty gộp 2 sản phẩm (nhiều team) thành 1. Khách hàng muốn biết công ty tổ chức lại các team thế nào.", "dung": "Theo agile ở quy mô lớn (ví dụ LeSS), cách tốt nhất là cho tất cả các team cùng tham gia và tự thiết kế lại cấu trúc team (self-designing workshop). Những người làm việc trực tiếp hiểu rõ nhất cách tổ chức phù hợp, và họ sẽ cam kết hơn với cấu trúc do chính họ tạo ra.", "sai": {"B": "Gộp theo thành phần (component) tạo ra component team, dễ gây phụ thuộc giữa các team.", "C": "Ghép mỗi vai trò một người theo cách cơ học, không do team quyết.", "D": "Quản lý tự tổ chức team theo ưu tiên — hợp lý nhưng vẫn là quyết định từ trên xuống."}, "meo": "Tổ chức lại team → để team TỰ thiết kế (self-manage).", "note": "Cột bên cạnh trong file ghi B. Câu này có nhiều tranh luận; đáp án của file là A."}, {"n": 15, "stem": "A client states that a product is not being built as requested.\nHow should the agile team address this?", "opts": {"A": "Conduct an internal review to validate functionality before shipping", "B": "Audit the quality control process to ensure that the product adheres to requirements", "C": "Lengthen iterations to ensure there is sufficient time to build functionality", "D": "Hold product review sessions with the client to obtain product acceptance"}, "a": "D", "th": "Khách hàng nói sản phẩm không được xây dựng đúng như yêu cầu.", "dung": "Tổ chức các buổi product review (demo) cùng khách hàng để họ xem, góp ý và chấp nhận sản phẩm. Phản hồi sớm và thường xuyên giúp sản phẩm đi đúng hướng.", "sai": {"A": "Review nội bộ không có khách hàng thì không biết khách muốn gì.", "B": "Audit quy trình QC chỉ kiểm tra \"làm đúng spec\", trong khi vấn đề là hiểu đúng nhu cầu.", "C": "Kéo dài iteration làm phản hồi chậm hơn — ngược lại."}, "meo": "Khách không hài lòng → cho khách xem sản phẩm thường xuyên (review/demo).", "note": ""}, {"n": 16, "stem": "A new product owner shares the product vision during the team launch event. The team asks for clarification on the product roadmap and its high-level features.\nWhat should the product owner do?", "opts": {"A": "Determine the required tasks for implementing the high-level features", "B": "Identify the detailed design for the high-level features", "C": "Prioritize the product backlog for the upcoming release", "D": "Estimate the user stories in the iteration backlog"}, "a": "C", "th": "PO mới chia sẻ product vision; team hỏi rõ về roadmap và các tính năng cấp cao.", "dung": "PO chịu trách nhiệm về giá trị và thứ tự ưu tiên của product backlog. Ưu tiên hóa backlog cho release sắp tới giúp team hiểu tính năng nào làm trước, kết nối vision với roadmap.", "sai": {"A": "Xác định task là việc của team.", "B": "Thiết kế chi tiết cũng là việc của team.", "D": "Ước lượng story là việc của team."}, "meo": "Việc của PO = ƯU TIÊN backlog. Task/thiết kế/ước lượng = việc của team.", "note": ""}, {"n": 17, "stem": "An agile practitioner wants to communicate the effect of technical debt on the project.\nWhat should the practitioner do?", "opts": {"A": "Post and discuss rises in the burn down chart", "B": "Adjust story points to account for technical debt", "C": "Log technical debt as an impediment", "D": "Add refactoring tasks to all stories"}, "a": "C", "th": "Muốn truyền đạt ảnh hưởng của technical debt (nợ kỹ thuật) lên dự án.", "dung": "Ghi technical debt như một impediment (trở ngại) giúp nó được hiển thị rõ ràng, được theo dõi và xử lý, mọi người đều thấy nó đang cản trở tiến độ.", "sai": {"A": "Burndown chart tăng có thể vì nhiều lý do, không truyền đạt rõ về nợ kỹ thuật.", "B": "Tăng story point để \"giấu\" nợ kỹ thuật làm sai lệch ước lượng, không minh bạch.", "D": "Thêm refactor vào mọi story là cứng nhắc, không truyền đạt ảnh hưởng."}, "meo": "Muốn mọi người THẤY vấn đề → ghi thành impediment.", "note": ""}, {"n": 18, "stem": "An agile coach realizes that a team responsible for a major release is a few months behind schedule. The marketing department is unaware of this delay, and is planning to start the marketing campaign and announce the release.\nWhat should the agile coach do?", "opts": {"A": "Meet with the agile team lead to discuss ways to improve the team velocity and get back on track", "B": "Use this as a learning opportunity and allow the team to handle the situation when the marketing campaign begins", "C": "In the upcoming retrospective, discuss ways to improve sharing project status information", "D": "Meet with the marketing stakeholders to explain that the team will miss the planned release date"}, "a": "D", "th": "Agile coach biết team trễ vài tháng so với release; bộ phận marketing không biết và sắp chạy chiến dịch, công bố ngày ra mắt.", "dung": "Minh bạch là ưu tiên số 1: phải gặp ngay stakeholder marketing để nói rõ sẽ trễ ngày phát hành, tránh thiệt hại lớn (công bố sai ngày).", "sai": {"A": "Tăng velocity không thể bù vài tháng trễ, và marketing vẫn không biết.", "B": "Để team \"học\" khi chiến dịch đã chạy — gây thiệt hại cho tổ chức, vô trách nhiệm.", "C": "Đợi đến retrospective là quá muộn."}, "meo": "Tin xấu ảnh hưởng stakeholder → báo NGAY, trực tiếp.", "note": ""}, {"n": 19, "stem": "The product owner of an agile project is frustrated because the team is unable to deliver as many features as expected. The product owner asks the team to reduce test-automation levels, since the quality assurance team will test the product at project completion. The product owner expects that more features will be delivered in each iteration using this approach.\nWhat should the agile practitioner do?", "opts": {"A": "Ask the opinion of key stakeholders and the client to ensure the correct approach is being used", "B": "Work with the team to use this approach, and request a quality assurance iteration after every three iterations", "C": "Propose to completely eliminate test automation, since this is a quality assurance function", "D": "Suggest merging the quality assurance and delivery teams to enhance each iteration's test-automation levels and redundancy"}, "a": "D", "th": "PO thất vọng (frustrated) vì team giao ít tính năng, yêu cầu giảm test tự động vì QA sẽ test lúc cuối dự án.", "dung": "Agile tích hợp chất lượng xuyên suốt (built-in quality). Đề xuất gộp QA vào team phát triển giúp tăng test tự động trong từng iteration, phát hiện lỗi sớm thay vì dồn về cuối.", "sai": {"A": "Hỏi stakeholder không giải quyết vấn đề phương pháp.", "B": "Giảm test và làm iteration QA riêng là \"mini waterfall\", nợ chất lượng tích tụ.", "C": "Bỏ hẳn test tự động là sai hoàn toàn với agile."}, "meo": "Chất lượng phải có trong MỖI iteration; QA là một phần của team.", "note": ""}, {"n": 20, "stem": "How can an agile practitioner ensure that all key stakeholders are properly engaged in planning?", "opts": {"A": "Collect stakeholder requirements", "B": "Conduct an iteration planning meeting", "C": "Communicate product backlog items to the stakeholders", "D": "Facilitate a product development roadmap workshop"}, "a": "D", "th": "Làm sao đảm bảo mọi stakeholder chính tham gia đúng mức vào việc lập kế hoạch?", "dung": "Workshop xây dựng product roadmap là hoạt động cộng tác, mời các stakeholder cùng định hướng sản phẩm — họ được tham gia thật sự chứ không chỉ nhận thông tin.", "sai": {"A": "Chỉ thu thập yêu cầu là một chiều.", "B": "Iteration planning chủ yếu dành cho team và PO, không phải tất cả stakeholder.", "C": "Thông báo backlog là truyền thông một chiều, không phải \"engage\"."}, "meo": "\"Engage\" stakeholder trong planning → workshop cộng tác.", "note": ""}, {"n": 21, "stem": "What should an agile practitioner do to ensure that the end product meets business requirements?", "opts": {"A": "Invite the team to iteration review meetings", "B": "Obtain agreement from the product owner on business requirements", "C": "Request that regular reports are sent to stakeholders", "D": "Confirm managers and stakeholders are invited to product review meetings"}, "a": "D", "th": "Làm gì để sản phẩm cuối đáp ứng yêu cầu kinh doanh?", "dung": "Đảm bảo quản lý và stakeholder được mời tham gia các buổi product review — họ trực tiếp xem sản phẩm và phản hồi, giúp điều chỉnh sớm.", "sai": {"A": "Team đương nhiên tham gia review; điều quan trọng là người có yêu cầu kinh doanh.", "B": "Thống nhất yêu cầu với PO là cần nhưng không đủ để xác nhận sản phẩm.", "C": "Báo cáo định kỳ là một chiều, không thay thế được việc xem sản phẩm thật."}, "meo": "Sản phẩm đúng nhu cầu kinh doanh → stakeholder tham gia review.", "note": ""}, {"n": 22, "stem": "Based on the backlog metrics in the chart, what can explain the jump in points at the end of iteration 4?", "opts": {"A": "The team neglected to account for support and maintenance costs associated with other support products", "B": "The team discovered that previously accepted work could be greatly improved and added story points associated with that work", "C": "The team realized that some stories were underestimated relative to other stories and re-estimated as needed", "D": "The team learned that the product owner needed to increase the output in the next release"}, "a": "C", "th": "Dựa vào biểu đồ backlog (file không kèm hình), điều gì giải thích việc tổng point tăng vọt ở cuối iteration 4?", "dung": "Khi team nhận ra một số story bị ước lượng thấp so với các story khác và ước lượng lại (re-estimate), tổng point của backlog sẽ tăng đột ngột. Đây là điều bình thường trong agile khi team hiểu rõ hơn về công việc.", "sai": {"A": "Chi phí hỗ trợ sản phẩm khác không nằm trong backlog sản phẩm này.", "B": "Công việc đã được chấp nhận thì không tự thêm point để \"cải thiện\".", "D": "PO muốn tăng output không làm tăng tổng point backlog."}, "meo": "Backlog tăng đột ngột → thường do re-estimate hoặc thêm scope.", "note": "Câu này đi kèm biểu đồ trong đề gốc, file Excel không có hình."}, {"n": 23, "stem": "A technical problem arises that will likely impact the stories planned for delivery in the current sprint.\nWhat should the scrum master do?", "opts": {"A": "Consider adding a story to the next sprint to seek resolution", "B": "Immediately solve the problem on behalf of the team", "C": "Ask the team to collaboratively work out a solution", "D": "Engage a technical manager to assist with finding a solution"}, "a": "C", "th": "Một vấn đề kỹ thuật phát sinh, có thể ảnh hưởng các story trong sprint hiện tại. SM nên làm gì?", "dung": "SM khuyến khích team cùng cộng tác tìm giải pháp. Team có chuyên môn và tự tổ chức.", "sai": {"A": "Đẩy sang sprint sau trong khi vấn đề ảnh hưởng sprint hiện tại.", "B": "SM tự giải quyết thay team — không phải servant leader.", "D": "Nhờ quản lý kỹ thuật trước khi team thử là sai thứ tự."}, "meo": "Giống câu 10: vấn đề kỹ thuật → team cùng giải quyết.", "note": ""}, {"n": 24, "stem": "How should an agile project leader interact with the product owner?", "opts": {"A": "Conduct regular one-on-one meetings to review development features and trace them back to the product roadmap", "B": "Ensure the they attend regular sprint meetings to provide product-feature feedback", "C": "Share any new versions of the project plan with them, including updated statuses for tasks and project milestones", "D": "Schedule meetings where they can provide team direction regarding new-feature priorities and upcoming sprints"}, "a": "B", "th": "Agile project leader nên tương tác với PO như thế nào?", "dung": "Đảm bảo PO tham gia đều đặn các sự kiện sprint để đưa phản hồi về tính năng. PO là người quyết định giá trị, sự có mặt của họ giúp team đi đúng hướng.", "sai": {"A": "Họp 1-1 riêng để rà soát tính năng loại trừ team.", "C": "Chia sẻ project plan với status task là cách quản lý truyền thống.", "D": "PO \"chỉ đạo team\" là sai — PO chỉ ưu tiên backlog, không chỉ đạo cách làm."}, "meo": "PO phải có mặt và phản hồi trong các sự kiện sprint.", "note": ""}, {"n": 25, "stem": "Midway through a sprint, a team member discovers that the product design fails to adhere to the organization's enterprise architecture standards. Since this required escalation to the architecture team for further analysis and resolution, the team was unable to deliver its sprint goal and the sprint was cancelled.\nWhat should the team have done to avoid this?", "opts": {"A": "Escalated the issue to management", "B": "Ensured the early engagement of key stakeholders", "C": "Provided feedback to the architecture team to change the enterprise architecture standards", "D": "Raised an exception for non-adherence to the enterprise architecture standards for this product"}, "a": "B", "th": "Giữa sprint phát hiện thiết kế không tuân thủ chuẩn kiến trúc doanh nghiệp; phải leo thang lên team kiến trúc, sprint bị hủy. Lẽ ra phải làm gì?", "dung": "Xác định và mời stakeholder chính (ở đây là team kiến trúc) tham gia ngay từ đầu. Nếu họ được tham gia sớm, yêu cầu về chuẩn kiến trúc đã được biết trước.", "sai": {"A": "Leo thang là phản ứng sau khi có chuyện, không phải phòng tránh.", "C": "Đòi đổi chuẩn kiến trúc của doanh nghiệp là không hợp lý.", "D": "Xin ngoại lệ không tuân thủ — né tránh vấn đề."}, "meo": "\"What should have been done?\" → thường là engage stakeholder SỚM.", "note": ""}, {"n": 26, "stem": "A team is transitioning from a predictive approach to an agile approach. Historically, the team has delivered work products that did not meet customer expectations.\nWhat agile practice can help the team to alleviate this?", "opts": {"A": "Test-driven development (TDD)", "B": "Clear definition of done and regular demos", "C": "Collaborative team planning games", "D": "Consistent team velocity"}, "a": "B", "th": "Team chuyển từ predictive sang agile; trước đây thường giao sản phẩm không đúng kỳ vọng khách hàng.", "dung": "Definition of Done rõ ràng giúp mọi người hiểu thế nào là \"xong\"; demo thường xuyên giúp khách hàng xem và phản hồi sớm → sản phẩm đúng kỳ vọng.", "sai": {"A": "TDD cải thiện chất lượng code, không đảm bảo đúng nhu cầu khách.", "C": "Planning game giúp lập kế hoạch, không trực tiếp kiểm tra kỳ vọng.", "D": "Velocity ổn định không liên quan đến việc đúng kỳ vọng."}, "meo": "Không đúng kỳ vọng khách → DoD rõ + demo thường xuyên.", "note": ""}, {"n": 27, "stem": "A team member on a scrum project previously provided support to another application. Due to this with that application, the team member's former supervisor continues assigning them tasks related to that project. The new project's scrum master includes these issues in the risk register.\nWhat should the scrum master do next?", "opts": {"A": "Monitor the threats and risks while allowing the team member to multitask on both projects", "B": "Assign more resources to the sprints to compensate for the absence of the team member", "C": "Ensure that the threats and risks are communicated and addressed", "D": "Assign fewer stories to the sprints so that the team member can still meet sprint goals"}, "a": "C", "th": "Thành viên team trước hỗ trợ ứng dụng khác; quản lý cũ vẫn tiếp tục giao việc. SM đã đưa vào risk register. Bước tiếp theo?", "dung": "Ghi risk chưa đủ — phải truyền đạt và xử lý (communicated and addressed) với các bên liên quan (quản lý cũ, PO...) để loại bỏ rủi ro.", "sai": {"A": "Chỉ theo dõi và để người đó làm nhiều việc cùng lúc — chấp nhận vấn đề.", "B": "Thêm người là tốn kém, không giải quyết gốc.", "D": "Giảm story là chịu thiệt mà không xử lý gốc rễ."}, "meo": "Ghi risk xong → phải COMMUNICATE + ADDRESS.", "note": ""}, {"n": 28, "stem": "An organization initiates a pilot project to introduce agile methodology for the successful delivery of projects.\nWhat should the project manager do to share this project's knowledge and learning with wider organizational business groups?", "opts": {"A": "Invite people from across the organization to attend daily stand ups", "B": "Invite people from across the organization to attend retrospectives", "C": "Invite people from across the organization to attend the release meeting and project retrospectives", "D": "Regularly meet with people across the organization to share the project's lessons learned and best practices"}, "a": "D", "th": "Dự án pilot agile; PM muốn chia sẻ kiến thức, bài học với các bộ phận rộng hơn trong tổ chức.", "dung": "Gặp gỡ định kỳ với các bộ phận để chia sẻ lessons learned và best practices — kênh trực tiếp, phù hợp với đối tượng bên ngoài team.", "sai": {"A": "Daily stand-up chỉ dành cho team.", "B": "Retrospective cần môi trường an toàn cho team; người ngoài vào sẽ khiến team ngại nói thật.", "C": "Tương tự B, mời người ngoài vào retrospective là không phù hợp."}, "meo": "Retro & stand-up là của TEAM, không mời người ngoài.", "note": ""}, {"n": 29, "stem": "A project team identifies a number of technical challenges with features in the next sprint.\nWhat should they do?", "opts": {"A": "Request direction from the technical manager", "B": "Encourage that product owner to reallocate the features to another sprint", "C": "Determine who is best qualified to address the challenges", "D": "Ask the product owner to assign the tasks to the most appropriately skilled resources"}, "a": "C", "th": "Team thấy nhiều thách thức kỹ thuật với các tính năng ở sprint tới.", "dung": "Team tự tổ chức: tự xác định ai phù hợp nhất để xử lý các thách thức.", "sai": {"A": "Xin chỉ đạo từ quản lý kỹ thuật — không tự tổ chức.", "B": "Đẩy tính năng sang sprint khác là né tránh.", "D": "PO không phân công task."}, "meo": "Ai làm gì → team tự quyết.", "note": ""}, {"n": 30, "stem": "The team is refining user stories during the backlog grooming session and confused on the acceptance criteria and level of details.\nWhat should the agile practitioner do?", "opts": {"A": "Complete the test cases before creating the story in the backlog", "B": "Define the detailed business requirements so that the team can continue with development", "C": "Define the user stories with just enough details so the team can collaborate continuously", "D": "Ensure the acceptance criteria includes testing scenarios, so the team can do through testing"}, "a": "C", "th": "Team bối rối về acceptance criteria và mức độ chi tiết khi refine user story.", "dung": "User story chỉ cần \"vừa đủ\" chi tiết (just enough) để team hiểu và tiếp tục trao đổi. Story là \"lời hứa cho một cuộc trò chuyện\" — chi tiết được làm rõ dần qua cộng tác liên tục.", "sai": {"A": "Viết hết test case trước khi tạo story là quá nặng nề.", "B": "Định nghĩa yêu cầu kinh doanh chi tiết là kiểu waterfall.", "D": "Acceptance criteria có kịch bản test là tốt, nhưng không trả lời câu hỏi về \"mức độ chi tiết\"."}, "meo": "Mức độ chi tiết của story → \"just enough\" (vừa đủ).", "note": "File ghi đáp án D. Theo nguyên tắc agile (\"vừa đủ chi tiết, cộng tác liên tục\") thì C phù hợp hơn và nhiều bộ đề chọn C."}, {"n": 31, "stem": "When prioritizing features to be delivered in an iteration, on what should an agile team defer work?", "opts": {"A": "High-risk and high-value", "B": "High-risk and low-value", "C": "Low-risk and low-value", "D": "Low-risk and high value"}, "a": "C", "th": "Khi ưu tiên tính năng, nên TRÌ HOÃN (defer) nhóm việc nào?", "dung": "Ma trận Risk-Value: Rủi ro thấp + giá trị thấp → làm sau cùng (hoặc bỏ). Thứ tự: (1) rủi ro cao–giá trị cao, (2) rủi ro thấp–giá trị cao, (3) rủi ro thấp–giá trị thấp. Rủi ro cao–giá trị thấp thì tránh.", "sai": {"A": "Rủi ro cao–giá trị cao → làm ĐẦU TIÊN.", "B": "Rủi ro cao–giá trị thấp → TRÁNH hẳn (không phải chỉ trì hoãn).", "D": "Rủi ro thấp–giá trị cao → làm sớm."}, "meo": "Defer = Low risk & Low value; Avoid = High risk & Low value.", "note": ""}, {"n": 32, "stem": "On an agile project, some of the development team is struggling to understand how the tasks and user stories fit into the overall product.\nHow should this be addressed?", "opts": {"A": "Review the iteration goals and have the team each describe the work to create shared understanding", "B": "Create a story map for the minimal viable product (MVP) functionality", "C": "Capture this as a task in the retrospective and ensure there is more details provided at the next planning session", "D": "Have the product owner explain the product vision and review the release plan with the team"}, "a": "D", "th": "Một số dev không hiểu task và user story liên quan thế nào tới tổng thể sản phẩm.", "dung": "PO giải thích product vision và review release plan với team → team thấy \"bức tranh lớn\", hiểu vì sao làm việc đó.", "sai": {"A": "Review mục tiêu iteration chỉ thấy phạm vi ngắn hạn.", "B": "Story map cho MVP hữu ích nhưng thiếu phần vision tổng thể.", "C": "Đợi retrospective là chậm, và thêm chi tiết không phải là thứ thiếu."}, "meo": "Không thấy \"bức tranh lớn\" → PO chia sẻ VISION.", "note": ""}, {"n": 33, "stem": "The customer needs assistance in determining the efficiency of a set of process activities within the solution.\nWhat should the agile team do?", "opts": {"A": "Discuss the efficiency at the next iteration retrospective", "B": "Review the process value stream to determine potential improvements", "C": "Review the value the customer receives from the user story to determine backlog priority", "D": "Discuss the performance of the solution at the next sprint review"}, "a": "B", "th": "Khách hàng cần hỗ trợ đánh giá hiệu quả của một chuỗi hoạt động quy trình trong giải pháp.", "dung": "Value stream mapping (phân tích dòng giá trị) giúp nhìn toàn bộ quy trình, tìm bước gây lãng phí/chờ đợi để cải tiến.", "sai": {"A": "Retrospective là cải tiến quy trình của team, không phải quy trình của khách.", "C": "Đánh giá giá trị story để ưu tiên backlog — không đánh giá hiệu quả quy trình.", "D": "Sprint review xem sản phẩm, không phân tích quy trình."}, "meo": "Hiệu quả quy trình / lãng phí → Value stream mapping.", "note": ""}, {"n": 34, "stem": "A new agile project manager accepts an assignment to manage a well-established team. Many team members have worked together on this product for several years. During a meeting, the project manager notices that team members offer little vocal interaction, yet all required tasks are completed on time.\nWhat type of behaviour does this describe?", "opts": {"A": "Synchronous", "B": "Collaborative", "C": "Passive-aggressive", "D": "Random"}, "a": "B", "th": "Team lâu năm ít trao đổi bằng lời nhưng mọi việc đều xong đúng hạn.", "dung": "Team trưởng thành hiểu nhau, phối hợp nhịp nhàng mà không cần nói nhiều — đó là hành vi cộng tác (collaborative). Kết quả tốt chứng minh sự cộng tác hiệu quả.", "sai": {"A": "\"Synchronous\" là đồng bộ thời gian, không mô tả hành vi.", "C": "Thụ động – gây hấn: không có dấu hiệu xung đột ngầm.", "D": "Ngẫu nhiên: kết quả ổn định cho thấy không ngẫu nhiên."}, "meo": "Ít nói mà vẫn xong việc tốt → Collaborative.", "note": ""}, {"n": 35, "stem": "Following a successful product release, senior management asks an agile team how to improve the value of the product for the next release.\nWhat should the team do?", "opts": {"A": "Conduct frequent demos and obtain feedback from users throughout the development of the next release", "B": "Inform senior management that since the product was successfully released, the project is considered delivered and should be closed", "C": "Request additional budget to implement a Scrum of Scrums approach to scale the teams and add capacity", "D": "Implement a better definition of done to ensure that continuous integration processes are managed effectively"}, "a": "A", "th": "Sau release thành công, ban lãnh đạo hỏi làm sao tăng giá trị sản phẩm ở release tiếp theo.", "dung": "Demo thường xuyên và lấy phản hồi người dùng trong suốt quá trình phát triển → biết chính xác cái gì mang lại giá trị.", "sai": {"B": "Đóng dự án — không trả lời câu hỏi tăng giá trị.", "C": "Mở rộng team (Scrum of Scrums) tăng năng lực chứ không chắc tăng giá trị.", "D": "DoD và CI cải thiện chất lượng kỹ thuật, không trực tiếp tăng giá trị cho người dùng."}, "meo": "Tăng giá trị → feedback người dùng thường xuyên.", "note": ""}, {"n": 36, "stem": "A team using Kanban identifies that their cycle time has significant variation. After brainstorming, the team determines that the root cause is the stories' varying sizes and risks.\nWhat should the team do?", "opts": {"A": "Reduce work in progress (WIP) limits to accommodate slack for riskier stories", "B": "Create a triage step on the Kanban board to pre-identify risky stories", "C": "Set a policy to break down stories larger than a specified complexity, then adjust the WIP", "D": "Create a dedicated overflow swim lane on the Kanban board for stories that are too large"}, "a": "C", "th": "Team Kanban có cycle time dao động lớn; nguyên nhân gốc là story khác nhau nhiều về kích thước và rủi ro.", "dung": "Đặt chính sách (explicit policy) chia nhỏ story vượt quá mức độ phức tạp nhất định, rồi điều chỉnh WIP → story đồng đều hơn → cycle time ổn định, dễ dự đoán.", "sai": {"A": "Giảm WIP không giải quyết việc story to nhỏ khác nhau.", "B": "Bước triage chỉ nhận diện, không xử lý.", "D": "Swim lane cho story to chỉ cô lập vấn đề, không làm đồng đều kích thước."}, "meo": "Cycle time dao động vì story khác size → chia nhỏ story.", "note": ""}, {"n": 37, "stem": "Two similar stories, A and B, are estimated at 3 story points. Story C, estimated at 8 points. After an iteration in which A and C were completed, it is found that story A took much longer than story C.\nWhat should the agile practitioner do?", "opts": {"A": "Assign story B more than 8 story points so to provide a better estimate", "B": "Add points to story B's iteration to account for the error but keep story B at 3 points", "C": "Assign more resources to story B to bring it in line with the estimate", "D": "Re-estimate all stories including values for A, B and C"}, "a": "D", "th": "Story A, B giống nhau (3 điểm), story C 8 điểm. Sau iteration, A tốn thời gian hơn C nhiều.", "dung": "Ước lượng tương đối đã sai → cần ước lượng lại TẤT CẢ story liên quan (A, B, C) để thang đo tương đối nhất quán, giúp kế hoạch sau chính xác hơn.", "sai": {"A": "Chỉ sửa B mà không xem lại tổng thể, thang đo vẫn lệch.", "B": "Giữ B ở 3 điểm trong khi đã biết sai — vô lý.", "C": "Thêm người không sửa được ước lượng."}, "meo": "Ước lượng tương đối sai → re-estimate tất cả.", "note": ""}, {"n": 38, "stem": "The product owner of a team starts the iteration review with a quick walkthrough of the iteration goal, the list of planned stories with status, and a demo of all the stories to the business.\nWhat should the product owner have done differently?", "opts": {"A": "Demonstrated only the completed stories and seek stakeholder feedback", "B": "Presented the budget situation and review the cost variance", "C": "Reviewed the test results to gain confidence from the stakeholders", "D": "Presented a demo of all the stories including the work in progress stories"}, "a": "A", "th": "PO mở đầu iteration review bằng mục tiêu, danh sách story kèm trạng thái, và demo TẤT CẢ story. Lẽ ra phải làm khác gì?", "dung": "Chỉ demo những story đã HOÀN THÀNH (đạt DoD) và lấy phản hồi stakeholder. Story chưa xong không được demo.", "sai": {"B": "Trình bày ngân sách, chênh lệch chi phí không phải mục đích của review.", "C": "Review kết quả test không phải trọng tâm; sản phẩm chạy được mới là bằng chứng.", "D": "Demo cả việc đang làm dở — chính là lỗi trong tình huống."}, "meo": "Review/Demo → chỉ việc DONE + lấy feedback.", "note": ""}, {"n": 39, "stem": "The risk profile of a project has increased beyond the upper threshold of tolerance. The product owner and project leader meet to discuss an approach for dealing with this.\nWhat should the team do next?", "opts": {"A": "Add risk mitigation tasks to the backlog, then prioritize in current and upcoming sprints", "B": "Add risk mitigation time to each requirement", "C": "Apply the 80/20 rule, reserving 20 percent of each sprint's capacity for risk mitigation", "D": "Hold all risks until they become issues, then add issue resolution tasks to the product backlog"}, "a": "A", "th": "Mức rủi ro vượt ngưỡng chịu đựng; PO và project leader đã bàn cách xử lý. Team làm gì tiếp?", "dung": "Thêm các task giảm thiểu rủi ro vào backlog, ưu tiên chúng trong sprint hiện tại và tiếp theo (risk-adjusted backlog). Rủi ro được xử lý như công việc bình thường, minh bạch.", "sai": {"B": "Thêm thời gian dự phòng cho mọi yêu cầu là \"độn\" ước lượng, không minh bạch.", "C": "Quy tắc 80/20 cứng nhắc, không dựa vào mức độ rủi ro thật.", "D": "Chờ rủi ro thành vấn đề rồi mới xử lý là bị động."}, "meo": "Xử lý rủi ro trong agile → risk-adjusted backlog.", "note": ""}, {"n": 40, "stem": "What should a team do when they complete all sprint goals earlier than expected?", "opts": {"A": "Begin working on an item in the backlog", "B": "Ask the scrum master to select an item from the backlog on which to work", "C": "Ask the product owner to select an item from the backlog on which to work", "D": "Jointly decide with the scrum master on an item from the backlog on which to work"}, "a": "C", "th": "Team hoàn thành mọi sprint goal sớm hơn dự kiến.", "dung": "PO là người quyết định ưu tiên và giá trị, nên team hỏi PO chọn hạng mục tiếp theo trong backlog.", "sai": {"A": "Tự lấy việc trong backlog mà không hỏi PO có thể chọn sai ưu tiên.", "B": "SM không quyết định ưu tiên backlog.", "D": "Tương tự B, SM không có vai trò đó."}, "meo": "Xong sớm → hỏi PO lấy việc tiếp.", "note": ""}, {"n": 41, "stem": "A product owner asks a newly formed scrum team how many story points will be completed in a sprint.\nWhat should the scrum master do?", "opts": {"A": "Engage the team to determine the sprint velocity based on previous agile projects", "B": "Average the sprint velocity based on input from team members", "C": "Share the sprint velocity obtained from the sponsor with the team", "D": "Run multiple sprints before determining the sprint velocity with the team"}, "a": "A", "th": "PO hỏi team scrum mới thành lập sẽ làm được bao nhiêu story point trong một sprint.", "dung": "Khi chưa có dữ liệu, SM cùng team ước tính velocity dựa trên kinh nghiệm từ các dự án agile trước (dữ liệu lịch sử của các thành viên). Team tự ước tính, không ai áp đặt.", "sai": {"B": "Lấy trung bình ý kiến từng người không phản ánh năng lực của team như một tổng thể.", "C": "Velocity từ sponsor là áp đặt từ bên ngoài.", "D": "Chạy vài sprint mới xác định là cách đúng về lâu dài, nhưng PO cần câu trả lời bây giờ."}, "meo": "Team mới cần dự đoán velocity → team ước tính dựa trên dữ liệu lịch sử.", "note": "Một số nguồn chọn D (chạy vài sprint để có velocity thật). Đáp án của file là A."}, {"n": 42, "stem": "A development team for a small company experiences long delays between product completion and release for validation and testing. The company is concerned that this will impact its ability to complete in the market place.\nWhat analysis should the team use to understand the issues?", "opts": {"A": "Risk management", "B": "Variance and trend", "C": "Kano model", "D": "Fishbone-diagram"}, "a": "D", "th": "Team công ty nhỏ bị chậm trễ lâu giữa lúc hoàn thành sản phẩm và lúc phát hành để kiểm thử. Dùng phân tích nào để hiểu vấn đề?", "dung": "Biểu đồ xương cá (Fishbone/Ishikawa) dùng để phân tích nguyên nhân gốc rễ (root cause) của một vấn đề — ở đây là sự chậm trễ.", "sai": {"A": "Quản lý rủi ro dành cho sự kiện có thể xảy ra, không phải vấn đề đang xảy ra.", "B": "Variance & trend cho thấy độ lệch/xu hướng, không tìm nguyên nhân.", "C": "Kano model phân loại tính năng theo mức hài lòng khách hàng."}, "meo": "\"Understand the issues / root cause\" → Fishbone (Ishikawa).", "note": ""}, {"n": 43, "stem": "Toward the end of a project, the product owner discovers that the project has a high probability of failure due to a critical feature not functioning as expected.\nWhat should the product owner do?", "opts": {"A": "Terminate the project to cut losses", "B": "Review possible options and make an informed decision to cut losses based on delivered business value", "C": "Bring in experts to increase the probability of success", "D": "Continue the project, release the product without the failing feature, and fix the feature in a subsequent release"}, "a": "B", "th": "Gần cuối dự án, PO phát hiện khả năng thất bại cao do một tính năng quan trọng không hoạt động.", "dung": "PO chịu trách nhiệm về giá trị: xem xét các phương án và ra quyết định sáng suốt, dựa trên giá trị kinh doanh đã giao được (có thể dừng sớm để cắt lỗ).", "sai": {"A": "Dừng ngay mà không phân tích là vội vàng.", "C": "Thêm chuyên gia chưa chắc cứu được và tốn kém, chưa đánh giá phương án.", "D": "Phát hành khi thiếu tính năng QUAN TRỌNG có thể gây hại."}, "meo": "PO quyết định dựa trên GIÁ TRỊ, sau khi xem xét các phương án.", "note": ""}, {"n": 44, "stem": "An agile coach is assigned to help a project team that was recently co-located close to a very popular business. Many team members visit this business during working hours which affects team performance.\nWhat should the agile coach do to mitigate this issue?", "opts": {"A": "Speak with the functional managers and come to an agreement that will resolve the issue", "B": "Explain to functional managers that too much control will inversely impact team morale", "C": "Meet with the team to discuss the issue and identify specific actions to reduce or eliminate the issue", "D": "Inform the team there will be penalties to anyone who visits that business during working hours"}, "a": "C", "th": "Team mới chuyển chỗ gần một quán nổi tiếng; nhiều người ghé quán trong giờ làm, ảnh hưởng hiệu suất.", "dung": "Agile coach họp với team để cùng thảo luận và đưa ra hành động cụ thể. Team tự đưa ra giải pháp sẽ cam kết thực hiện tốt hơn.", "sai": {"A": "Giải quyết qua quản lý chức năng — từ trên xuống.", "B": "Không giải quyết vấn đề.", "D": "Phạt là cách mệnh lệnh, làm giảm tinh thần."}, "meo": "Vấn đề hành vi của team → bàn với team, team tự quyết.", "note": ""}, {"n": 45, "stem": "After completing the release plan, the team realizes that the project is very likely to have a negative ROI.\nWhat should the team do?", "opts": {"A": "Prioritize the backlog, and remove low-priority stories from the release plan to ensure a positive ROI", "B": "Replace some team embers to reduce the release costs and minimize a negative ROI", "C": "Perform a root-cause analysis to remove waste from the delivery process and increase the ROI", "D": "Communicate the risk of a negative ROI to the stakeholders, and update the release plan"}, "a": "D", "th": "Sau khi làm release plan, team nhận ra ROI rất có thể bị âm.", "dung": "Minh bạch: thông báo rủi ro ROI âm cho stakeholder và cập nhật release plan. Stakeholder (người bỏ tiền) phải là người tham gia quyết định có tiếp tục hay không.", "sai": {"A": "Bỏ bớt story để ROI dương — team tự quyết thay stakeholder, có thể bỏ mất giá trị.", "B": "Thay người để giảm chi phí — không phù hợp.", "C": "Root cause để giảm lãng phí là tốt nhưng chưa thông báo cho stakeholder."}, "meo": "Rủi ro lớn về kinh doanh → minh bạch với stakeholder trước.", "note": ""}, {"n": 46, "stem": "During planning for the next iteration, an agile team identifies most of the story points that are expected to be delivered.\nHow should an agile practitioner work with the team to help identify the iteration's remaining scope?", "opts": {"A": "Convince the team to stop planning and keep the size small", "B": "Identify the technically minimal and achievable tasks", "C": "Refer to the remaining prioritized backlog items", "D": "Select some of the smallest items from the backlog"}, "a": "C", "th": "Khi lập kế hoạch iteration, team đã xác định phần lớn story point dự kiến. Làm sao xác định phần phạm vi còn lại?", "dung": "Lấy tiếp các hạng mục theo thứ tự ưu tiên của backlog (do PO sắp xếp) cho đến khi đầy năng lực. Luôn làm theo giá trị/ưu tiên.", "sai": {"A": "Dừng lập kế hoạch khi còn năng lực — lãng phí.", "B": "Chọn theo \"tối thiểu kỹ thuật\" bỏ qua ưu tiên kinh doanh.", "D": "Chọn item nhỏ nhất để lấp chỗ trống — bỏ qua thứ tự ưu tiên."}, "meo": "Luôn chọn việc theo THỨ TỰ ƯU TIÊN của backlog.", "note": ""}, {"n": 47, "stem": "During a project meeting, a team is faced with a difficult decision. After discussion and deliberation, the project leader makes the final decision and ends the discussion. This causes a team member to withdraw from future collaboration.\nHow could the project leader have avoided this?", "opts": {"A": "Led by example by encouraging the team to engage in consensus-driven decision making", "B": "Iterated the need for agile teams to make quick decisions, then followed up with that team member", "C": "Empowered a team member to facilitate decision making, then made a final decision on behalf of the team", "D": "Refrained from participating in the team's decision-making process, except to document and communicate results"}, "a": "A", "th": "Leader tự ra quyết định cuối cùng và kết thúc thảo luận, khiến một thành viên rút lui khỏi việc cộng tác. Lẽ ra phải làm gì?", "dung": "Làm gương bằng việc khuyến khích team ra quyết định theo đồng thuận (consensus) → ai cũng được lắng nghe, cùng sở hữu quyết định.", "sai": {"B": "Nhấn mạnh \"quyết nhanh\" rồi mới hỏi thăm — vẫn là áp đặt.", "C": "Cho người khác điều phối rồi leader vẫn quyết thay team — vẫn sai.", "D": "Hoàn toàn đứng ngoài cũng không đúng — leader nên tạo điều kiện (facilitate)."}, "meo": "Quyết định của team → consensus, leader là người tạo điều kiện.", "note": ""}, {"n": 48, "stem": "During sprint planning the product owner wants the team to prioritize and deliver a number of features which have the highest business value. Due to technical dependencies, the team does not agree with the prioritization.\nWhat should the project leader do?", "opts": {"A": "Encourage the product owner and team to reprioritize the features and select ones which can be delivered without any dependencies", "B": "Encourage the team to continue with the current plan, do what they can, and carry forward the work not done to the next iteration", "C": "Ensure the team captures the technical dependencies as issues within the backlog optimization", "D": "Ensure that the required subject matter experts (SMEs) are engaged by the product owner to help with backlog prioritization"}, "a": "C", "th": "PO muốn ưu tiên các tính năng giá trị kinh doanh cao nhất, nhưng team không đồng ý vì phụ thuộc kỹ thuật.", "dung": "Ghi lại các phụ thuộc kỹ thuật như các vấn đề (issues) trong backlog để chúng được nhìn thấy và ưu tiên cùng với tính năng, phục vụ sprint goal. Giá trị vẫn là trọng tâm, nhưng phụ thuộc phải được quản lý minh bạch.", "sai": {"A": "Chỉ chọn tính năng không có phụ thuộc — có thể bỏ qua những tính năng giá trị nhất.", "B": "Cứ làm rồi dồn việc dở dang sang sau — không giải quyết gốc.", "D": "Mời SME giúp ưu tiên chưa giải quyết việc phụ thuộc phải được quản lý."}, "meo": "Phụ thuộc kỹ thuật → đưa vào backlog để quản lý minh bạch.", "note": ""}, {"n": 49, "stem": "During a project review, the team discovers customer feedback that would add scope. The project leader is concerned that the team will be unable to incorporate this feedback and still meet the product launch date.\nWhat should the project leader do?", "opts": {"A": "Finalize the feedback in the form of a change request", "B": "Limit the scope of the feedback to only those changes that the team can feasibly accommodate", "C": "Encourage all feedback, then work with the customer to prioritize work for future sprints", "D": "Allow the team to decide what feedback to incorporate"}, "a": "C", "th": "Có phản hồi của khách làm tăng phạm vi; leader lo team không kịp ngày ra mắt.", "dung": "Agile chào đón phản hồi. Ghi nhận tất cả, sau đó cùng khách hàng ưu tiên cho các sprint sau → khách quyết định cái gì quan trọng nhất.", "sai": {"A": "Change request chính thức là quy trình truyền thống, nặng nề.", "B": "Tự giới hạn phản hồi — bỏ lỡ giá trị và không có khách tham gia.", "D": "Team tự quyết phản hồi nào được làm — việc ưu tiên thuộc về PO/khách."}, "meo": "Phản hồi mới → hoan nghênh + ưu tiên cùng khách.", "note": ""}, {"n": 50, "stem": "An agile team is preparing a release plan for a project.\nWhat information will the team need to complete this plan?", "opts": {"A": "Amount of work needed to complete a single user story", "B": "Amount of work that can be accomplished by each team member", "C": "Amount of work that can be accomplished in an iteration", "D": "Amount of work that can be accomplished by the entire team"}, "a": "C", "th": "Team chuẩn bị release plan cần thông tin gì?", "dung": "Cần biết lượng công việc làm được trong mỗi iteration (velocity). Tổng scope ÷ velocity → số iteration cần → ngày release.", "sai": {"A": "Công sức cho 1 story chưa đủ để lên kế hoạch release.", "B": "Năng lực từng người không dùng trong agile; team là đơn vị.", "D": "\"Toàn bộ team\" làm được bao nhiêu nhưng thiếu yếu tố thời gian (mỗi iteration)."}, "meo": "Release plan cần VELOCITY (việc/iteration).", "note": ""}, {"n": 51, "stem": "Why should a project team reduce the work in progress?", "opts": {"A": "It indicates poor project quality", "B": "It represents team member's utilization", "C": "It represents unrealized value", "D": "It shows that the project is behind schedule"}, "a": "C", "th": "Vì sao nên giảm work in progress (WIP)?", "dung": "Việc đang làm dở chưa mang lại giá trị cho khách hàng — đó là giá trị chưa được hiện thực hóa (unrealized value), thậm chí là lãng phí. Giảm WIP → hoàn thành nhanh → giá trị đến sớm.", "sai": {"A": "WIP cao không trực tiếp nói lên chất lượng kém.", "B": "WIP không phải thước đo mức sử dụng nhân sự.", "D": "WIP không cho biết dự án có trễ hay không."}, "meo": "WIP = giá trị chưa hiện thực hóa.", "note": ""}, {"n": 52, "stem": "During a review session, a customer representative is concerned that a story fails to satisfy the scope of work. However, the product owner declares that the scope of work is complete.\nWhat should be done with this story?", "opts": {"A": "Mark it as incomplete and prioritize it for the next sprint", "B": "Mark it as complete, since the product owner has the final say", "C": "Discard it and create a new story for the remaining scope of work", "D": "Mark it as complete, since the team completed the scope of work"}, "a": "A", "th": "Đại diện khách lo story chưa đáp ứng đủ phạm vi, nhưng PO tuyên bố đã xong.", "dung": "Khi khách hàng còn lo ngại, story chưa thực sự đáp ứng nhu cầu → đánh dấu chưa hoàn thành và ưu tiên cho sprint sau. Sự hài lòng của khách là ưu tiên.", "sai": {"B": "PO có quyền chấp nhận, nhưng bỏ qua ý kiến khách hàng là rủi ro.", "C": "Hủy story và tạo story mới làm mất dấu vết công việc.", "D": "Team cho rằng đã làm xong không có nghĩa là đúng nhu cầu."}, "meo": "Khách chưa hài lòng → chưa xong.", "note": ""}, {"n": 53, "stem": "Senior management is frustrated at the lack of a detailed implementation plan that shows exactly when the project will end and when all requirements will be met.\nThe team has been using a rolling wave planning approach so far on the project.\nHow should the agile practitioner explain to senior management the benefits of this approach?", "opts": {"A": "It ensures a consistent level of detail is available in the project schedule", "B": "It prevents a wasteful build-up of requirements inventory that may never be processes", "C": "It provides a concrete definition of product scope, cost and duration", "D": "It allows the team to lock down the stories to be included in a release"}, "a": "B", "th": "Ban lãnh đạo khó chịu vì không có kế hoạch chi tiết cho đến hết dự án; team dùng rolling wave planning.", "dung": "Rolling wave chỉ lập kế hoạch chi tiết cho phần gần, phần xa để ở mức tổng quát → tránh tích trữ yêu cầu chi tiết có thể không bao giờ được làm (lãng phí theo Lean).", "sai": {"A": "Rolling wave cố ý KHÔNG có mức độ chi tiết đồng đều.", "C": "Nó không đưa ra định nghĩa cụ thể về scope, cost, duration.", "D": "Nó không \"khóa\" story; ngược lại, cho phép thay đổi."}, "meo": "Rolling wave = chi tiết cái gần, tránh lãng phí yêu cầu chi tiết sớm.", "note": ""}, {"n": 54, "stem": "A team member is stressed due to a heavy workload, while other team members have some slack in their schedules.\nHow should the team lead address this?", "opts": {"A": "Inform management, and suggest that additional resources may be required", "B": "Discuss the issue with the team in the daily stand up meetings", "C": "Meet personally with the stressed team member to brainstorm ways to better manage their time", "D": "Begin tracking the stressed team member's tasks in a separate backlog for additional analysis and reporting"}, "a": "B", "th": "Một người quá tải, căng thẳng, trong khi người khác có thời gian trống.", "dung": "Đưa vấn đề ra daily stand-up để team biết và tự cân bằng công việc (người rảnh hỗ trợ). Team tự tổ chức.", "sai": {"A": "Xin thêm người khi trong team còn người rảnh là không hợp lý.", "C": "Chỉ giúp cá nhân quản lý thời gian, không giải quyết việc phân bổ không đều.", "D": "Theo dõi riêng một người là vi mô hóa quản lý."}, "meo": "Mất cân bằng tải trong team → đưa ra để team tự cân bằng.", "note": ""}, {"n": 55, "stem": "A product owner for two highly visible projects spends a great deal of time meeting with and reporting to senior stakeholders. The product owner is overwhelmed because both project teams request clarification on the requirements and the overall priorities.\nWhat should the agile project manager do?", "opts": {"A": "Provide both project teams with the highest priority needs", "B": "Request the project team's questions in writing prior to the next meeting", "C": "Facilitate a meeting with each team and the product owner to finds a solution", "D": "Provide both teams with each project's documentation"}, "a": "C", "th": "PO của 2 dự án lớn quá tải; cả 2 team đều cần làm rõ yêu cầu và ưu tiên.", "dung": "PM tạo điều kiện (facilitate) cuộc họp giữa từng team và PO để cùng tìm giải pháp (ví dụ: PO ủy quyền, sắp lịch cố định...).", "sai": {"A": "PM tự đưa ra ưu tiên — làm thay việc của PO.", "B": "Gửi câu hỏi bằng văn bản chậm, không giải quyết sự quá tải.", "D": "Tài liệu không thay được việc trao đổi với PO."}, "meo": "Vai trò PM/SM = facilitate để các bên cùng giải quyết.", "note": ""}, {"n": 56, "stem": "A seven-member agile team's composition varies considerably in age, gender, culture, personality type, and professional background.\nWhen planning a team-building event, what type of interpersonal skills should the project leader use?", "opts": {"A": "Networking", "B": "Social awareness", "C": "Communication", "D": "Leadership"}, "a": "B", "th": "Team 7 người rất đa dạng (tuổi, giới tính, văn hóa, tính cách, chuyên môn). Khi tổ chức team building cần kỹ năng gì?", "dung": "Social awareness (nhận thức xã hội) — một phần của trí tuệ cảm xúc (EQ): hiểu và tôn trọng sự khác biệt, cảm xúc, nhu cầu của người khác để hoạt động phù hợp cho mọi người.", "sai": {"A": "Networking là xây dựng quan hệ bên ngoài.", "C": "Giao tiếp quan trọng nhưng chung chung, không nhắm đến sự đa dạng.", "D": "Lãnh đạo quá rộng."}, "meo": "Đa dạng văn hóa/tính cách → Social awareness (EQ).", "note": ""}, {"n": 57, "stem": "Due to its complexity, a new team member struggles with developing a concise user story.\nWhat advice should the agile practitioner give to assist with developing the story?", "opts": {"A": "Hand the story over to a more experienced team member", "B": "Break the story up and focus on the most valuable parts", "C": "Discuss the story at the retrospective", "D": "Pick another story from the product backlog"}, "a": "B", "th": "Thành viên mới khó viết user story ngắn gọn vì story quá phức tạp.", "dung": "Chia nhỏ story và tập trung vào phần có giá trị nhất — story nhỏ dễ viết, dễ hiểu, dễ ước lượng (INVEST: Small).", "sai": {"A": "Giao cho người khác — người mới không học được gì.", "C": "Retrospective là bàn về quy trình, không phải viết story.", "D": "Né tránh bằng cách chọn story khác."}, "meo": "Story phức tạp → chia nhỏ, giữ phần giá trị nhất.", "note": ""}, {"n": 58, "stem": "Trend analysis shows that velocity is significantly higher than predicted and the release can be completed one month ahead of schedule. The team recommends changing the end date to reflect this.\nWhat should the agile practitioner do?", "opts": {"A": "Jointly meet with the team and product owner to discuss options and determine the end date", "B": "Announce that the team has exceeded the predicted velocity, and that the end date will be earlier than planned", "C": "Ask the product owner to include additional features in the product backlog, then re-plan subsequent iterations", "D": "Ask the team to decrease velocity to meet contractual obligations and document this decision"}, "a": "A", "th": "Velocity cao hơn dự đoán, có thể xong sớm 1 tháng; team đề nghị đổi ngày kết thúc.", "dung": "Cùng team và PO thảo luận các phương án (xong sớm hay thêm tính năng...) rồi quyết định ngày kết thúc. Quyết định ảnh hưởng kinh doanh cần có PO.", "sai": {"B": "Tự công bố mà không bàn với PO.", "C": "Tự quyết thêm tính năng — chỉ là một trong các phương án.", "D": "Bảo team làm chậm lại — vô lý và lãng phí."}, "meo": "Thay đổi lớn về kế hoạch → bàn cùng team + PO.", "note": ""}, {"n": 59, "stem": "A team's technical lead believes that manual testing tasks should be conducted by junior team members below their level. The junior team members think it is unfair and refuse the tasks.\nWhat should the scrum master do?", "opts": {"A": "Tell the technical lead to do the testing", "B": "Facilitate an open and focused team discussion that reinforces team agreements", "C": "Ask the team manager to advise the technical lead that all tasks are important", "D": "Encourage the team to take ownership of the delivery"}, "a": "B", "th": "Tech lead cho rằng test thủ công là việc dành cho junior; junior thấy bất công và từ chối.", "dung": "SM tạo điều kiện cho một buổi thảo luận cởi mở, tập trung, củng cố các thỏa thuận chung của team (working agreements) — team tự giải quyết xung đột.", "sai": {"A": "SM ra lệnh cho tech lead — mệnh lệnh.", "C": "Nhờ quản lý can thiệp — leo thang không cần thiết.", "D": "Quá chung chung, không xử lý xung đột."}, "meo": "Xung đột trong team → facilitate thảo luận + team agreements.", "note": ""}, {"n": 60, "stem": "Midway through a project, the product owner learns from the sponsor that a major component, which is already 20 percent complete, is unimportant to users. The component was part of the approved scope and a key selling point for the project.\nWhat should the product owner do next?", "opts": {"A": "Obtain approval from the change control board to discontinue the component", "B": "Ask the team to continue developing the component", "C": "Ask the team to discontinue developing the component", "D": "Request the sponsor's formal approval to discontinue the component"}, "a": "C", "th": "Giữa dự án, sponsor cho PO biết một thành phần lớn (đã xong 20%) không quan trọng với người dùng.", "dung": "PO có quyền quyết định về backlog và giá trị → yêu cầu team dừng phát triển thành phần đó, tránh lãng phí.", "sai": {"A": "CCB là quy trình truyền thống.", "B": "Tiếp tục làm thứ không có giá trị = lãng phí.", "D": "Thông tin đã đến từ chính sponsor; không cần phê duyệt chính thức thêm."}, "meo": "Không còn giá trị → PO quyết định dừng.", "note": ""}, {"n": 61, "stem": "A project team meets to estimate user stories for a sprint. While an important non-functional requirement must be delivered in the sprint, the estimate exceeds sprint capacity.\nWhat should the team do?", "opts": {"A": "Estimate only functional requirements that will impact product quality", "B": "Add team resources", "C": "Refer the issue tot eh product owner", "D": "Break non-functional requirements into those that can be delivered in the given sprint"}, "a": "D", "th": "Một yêu cầu phi chức năng (NFR) quan trọng phải có trong sprint, nhưng ước lượng vượt năng lực sprint.", "dung": "Chia nhỏ NFR thành các phần có thể giao trong sprint này — vẫn đáp ứng yêu cầu bắt buộc trong khả năng.", "sai": {"A": "Bỏ qua NFR là sai, nó quan trọng.", "B": "Thêm người giữa chừng không hiệu quả.", "C": "Đẩy cho PO mà không đề xuất giải pháp."}, "meo": "Quá lớn cho sprint → chia nhỏ.", "note": ""}, {"n": 62, "stem": "A development team and product owner disagrees on a user story in the product backlog.\nWhat should the agile practitioner do?", "opts": {"A": "Have the development team follow the product owner's direction", "B": "Openly challenge the product owner in the effort to poke holes in their approach", "C": "Facilitate a conversation about the user story between the development team and the product owner", "D": "Serve as a nonpartisan evaluator of each option, and provide direction to the development team and product owner"}, "a": "C", "th": "Team phát triển và PO bất đồng về một user story.", "dung": "Agile practitioner tạo điều kiện cuộc trao đổi giữa hai bên để cùng hiểu và thống nhất.", "sai": {"A": "Bắt team nghe theo PO — không giải quyết bất đồng.", "B": "Công khai chỉ trích PO — phá vỡ sự tôn trọng.", "D": "Tự làm trọng tài và chỉ đạo — không phải servant leader."}, "meo": "Bất đồng → FACILITATE trao đổi.", "note": ""}, {"n": 63, "stem": "During a planning session, four out of five team members vote to include eight story points in a particular story, while the fifth member votes for five story points.\nHow should this be handled?", "opts": {"A": "The story should be assigned eight story points as per the majority vote", "B": "The story should be added to the backlog and reassessed later", "C": "The story should be assigned points after a discussion with the fifth team member to see if a consensus can be reached", "D": "The decision for the number of story points should be made by the customer"}, "a": "C", "th": "Planning poker: 4/5 người chọn 8 điểm, 1 người chọn 5.", "dung": "Thảo luận với người có ý kiến khác để hiểu lý do (có thể họ biết điều người khác chưa biết) và đạt đồng thuận. Đây là bản chất của planning poker.", "sai": {"A": "Lấy theo đa số bỏ qua thông tin giá trị.", "B": "Hoãn lại không cần thiết.", "D": "Khách hàng không ước lượng."}, "meo": "Planning poker khác nhau → thảo luận đến đồng thuận.", "note": ""}, {"n": 64, "stem": "A project is starting and the type of work is complex and suitable for agile. In assessing the team members, it appears that co-location would be a challenge.\nWhat should the agile practitioner do?", "opts": {"A": "Select and implement collaboration tools to augment team interactions", "B": "Provide each geographical area with their own product owner and divide the work between the teams", "C": "Increase the number of requirements documents and ensure they are clearly communicated", "D": "After several sprints, calculate velocity based on primary team location and use secondary team as reserve"}, "a": "A", "th": "Công việc phức tạp, phù hợp agile, nhưng khó ngồi chung (co-location).", "dung": "Chọn và triển khai công cụ cộng tác (video call, chat, bảng online...) để tăng cường tương tác cho team phân tán.", "sai": {"B": "Chia mỗi vùng một PO làm phân mảnh sản phẩm.", "C": "Tăng tài liệu là đi ngược agile.", "D": "Coi team thứ hai là \"dự bị\" — vô lý."}, "meo": "Team phân tán → công cụ cộng tác.", "note": ""}, {"n": 65, "stem": "Team A is working on the second sprint of a product release. Team B, which is an interdependent team located on the same floor, requires exclusive and frequent information to complete its sprint goal.\nWhat should the agile team do?", "opts": {"A": "Create a central repository for information, and provide access to team B", "B": "Use an information board that will be visible to all passing through the workspace", "C": "Email all stakeholders with status updates", "D": "Provide team B with the information on an area needed a basis"}, "a": "A", "th": "Team B (cùng tầng, phụ thuộc) cần thông tin riêng và thường xuyên từ team A.", "dung": "Tạo kho thông tin trung tâm và cấp quyền cho team B → họ tự lấy thông tin bất kỳ lúc nào, thông tin \"riêng\" vẫn được kiểm soát.", "sai": {"B": "Bảng thông tin công khai không phù hợp với thông tin riêng (exclusive).", "C": "Email cho tất cả stakeholder — không đúng đối tượng.", "D": "Cung cấp theo yêu cầu từng lần — chậm, không đáp ứng \"thường xuyên\"."}, "meo": "Thông tin riêng + thường xuyên → kho trung tâm có phân quyền.", "note": ""}, {"n": 66, "stem": "Chart Base on the burn down chart, what is the iteration's status?", "opts": {"A": "It trended ahead of scheduled and completed everything on time", "B": "It took more time than expected and had to be lengthened", "C": "It trended behind schedule and did not complete everything on time", "D": "It took less time than expected and had to be shortened"}, "a": "C", "th": "Dựa vào burndown chart (file không có hình), trạng thái iteration là gì?", "dung": "Trong đề gốc, đường thực tế nằm trên đường lý tưởng và đến cuối iteration vẫn chưa về 0 → trễ tiến độ và không hoàn thành hết.", "sai": {"A": "Đi trước tiến độ thì đường thực tế nằm DƯỚI đường lý tưởng.", "B": "Iteration trong agile có time box cố định, không kéo dài.", "D": "Cũng không rút ngắn iteration."}, "meo": "Burndown: đường thực tế TRÊN đường lý tưởng = trễ; chưa về 0 = chưa xong.", "note": "Câu này đi kèm biểu đồ trong đề gốc, file Excel không có hình."}, {"n": 67, "stem": "During planning sessions, an agile practitioner notices that some team members do not share common ideas.\nWhat should the agile practitioner do?", "opts": {"A": "Ask the team if they would like to adopt alternative techniques", "B": "Create a team norms document to set particular guidelines", "C": "Ask the scrum master to resolve the issue at the stand up meeting", "D": "Capture feedback during lessons learned at the end of the iteration"}, "a": "A", "th": "Trong planning, một số thành viên không chia sẻ ý kiến.", "dung": "Hỏi team có muốn thử kỹ thuật khác (ví dụ silent writing, planning poker...) để mọi người dễ đóng góp hơn. Team tự quyết cách làm.", "sai": {"B": "Đặt quy định cứng — áp đặt.", "C": "Stand-up không phải nơi xử lý việc này.", "D": "Đợi đến cuối iteration là chậm."}, "meo": "Có người không chia sẻ → thử kỹ thuật khác (hỏi ý team).", "note": ""}, {"n": 68, "stem": "More details for a story are required before the upcoming sprint planning meeting.\nWhat should the scrum master do?", "opts": {"A": "Email the product owner requesting detailed story specifications and wait for a response", "B": "Gather the details from the team members before sprint planning", "C": "Schedule a story grooming session with the product owner before sprint planning", "D": "Conduct a planning poker session with the team"}, "a": "C", "th": "Cần thêm chi tiết cho một story trước buổi sprint planning.", "dung": "Lên lịch backlog grooming (refinement) với PO trước sprint planning để làm rõ story.", "sai": {"A": "Email và ngồi đợi — thụ động, chậm.", "B": "Team không phải nguồn yêu cầu; PO mới là người rõ nhất.", "D": "Planning poker là ước lượng, cần chi tiết trước."}, "meo": "Story thiếu chi tiết → grooming/refinement với PO.", "note": ""}, {"n": 69, "stem": "Prior to a retrospective, discussions among team members indicate conflict. An agile practitioner wants to ensure an open and safe environment during the retrospective.\nWhat should the agile practitioner do?", "opts": {"A": "Review established ground rules with the team", "B": "Ask team members specific questions to identify the cause", "C": "Encourage the team to continue working to maintain the iteration's schedule", "D": "Meet with the product owner and stakeholders to discuss the issue"}, "a": "A", "th": "Trước retrospective có dấu hiệu xung đột; muốn retro là môi trường cởi mở, an toàn.", "dung": "Nhắc lại các quy tắc chung (ground rules) đã thống nhất → tạo an toàn tâm lý ngay đầu buổi.", "sai": {"B": "Hỏi dồn vào nguyên nhân có thể làm căng thẳng thêm.", "C": "Lờ đi xung đột.", "D": "Kéo PO và stakeholder vào — không phải việc của họ."}, "meo": "Retro an toàn → nhắc ground rules.", "note": ""}, {"n": 70, "stem": "A company is considering developing a new, complex application that will require a large initial investment. However, if successful, the profit potential is high.\nWhen preparing an analysis, what should be used to encourage stakeholders who are concerned about project failure to authorize the initial investment?", "opts": {"A": "Calculated planned percent complete (PPC)", "B": "Many small minimally marketable features (MMFs)", "C": "Story points rather than cost estimates", "D": "Calculated earned value (EV)"}, "a": "B", "th": "Ứng dụng mới phức tạp, đầu tư ban đầu lớn, tiềm năng lợi nhuận cao; stakeholder lo thất bại.", "dung": "Chia thành nhiều MMF nhỏ (minimally marketable features) → giao giá trị sớm, thu hồi vốn sớm, giảm rủi ro, có thể dừng nếu không hiệu quả.", "sai": {"A": "PPC là chỉ số tiến độ, không giảm rủi ro đầu tư.", "C": "Story point không trấn an được về tài chính.", "D": "EV đo hiệu suất, không giảm rủi ro."}, "meo": "Giảm rủi ro đầu tư → giao giá trị sớm bằng MMF nhỏ.", "note": ""}, {"n": 71, "stem": "While reviewing the sprint burn down during a stand up, the scrum team identifies that they have fallen behind. Upon further discussion, they discover that some quality assurance (QA) team members were unable to use the new automation framework, which caused a bottleneck.\nWhat should the scrum team do?", "opts": {"A": "For upcoming sprints, have QA team members ensure that their respective skill sets are considered when accepting stories", "B": "Have QA team members with the appropriate skill sets spend extra to help the team succeed", "C": "Ensure that QA team members who lack the appropriate skill up for training within the next few weeks", "D": "Ask QA team members experienced with the new automation framework to cross-train the other QA members"}, "a": "D", "th": "Team trễ do một số QA không dùng được framework tự động mới, gây nút thắt.", "dung": "Nhờ QA đã thành thạo cross-train cho người khác → giải quyết nhanh, lâu dài, tăng tính đa năng của team.", "sai": {"A": "Chỉ nhận story theo kỹ năng — không giải quyết gốc.", "B": "Bắt làm thêm giờ — không bền vững.", "C": "Đi đào tạo trong vài tuần tới — chậm."}, "meo": "Thiếu kỹ năng trong team → cross-training.", "note": ""}, {"n": 72, "stem": "An organization highly values security. However, a team member on a project has found a way to save time and money with less robust security features.\nWhat should the team member do?", "opts": {"A": "Influence the customer", "B": "Mention the idea at the next retrospective", "C": "Show the customer how much time and money would be saved", "D": "Present the idea at the next ceremony attended by stakeholders to obtain their input"}, "a": "B", "th": "Tổ chức rất coi trọng bảo mật; một thành viên tìm cách tiết kiệm thời gian/tiền bằng bảo mật kém hơn.", "dung": "Nêu ý tưởng ở retrospective để team cùng thảo luận, đánh giá có phù hợp với giá trị của tổ chức không.", "sai": {"A": "Tự đi thuyết phục khách — vượt quyền team.", "C": "Tương tự A.", "D": "Đưa trực tiếp ra stakeholder khi chưa bàn với team."}, "meo": "Ý tưởng cải tiến quy trình → bàn trong team ở retro trước.", "note": ""}, {"n": 73, "stem": "During its first sprint, a new scrum team realizes that it has insufficient team members with test automation skills to efficiently complete its stories.\nWhat should the team do?", "opts": {"A": "Cross-train some members in the automation framework to broaden their capacity with that skill", "B": "Ask the product owner to add team members to boost this particular skill set", "C": "Send a member to automation framework training when funds are available", "D": "Avoid using test automation by swarming on the testing tasks and using manual testing"}, "a": "A", "th": "Sprint đầu, team mới thiếu người có kỹ năng test tự động.", "dung": "Cross-train một số thành viên về framework tự động → tăng năng lực team, tạo thành viên \"chữ T\".", "sai": {"B": "Thêm người — tốn kém, không xây dựng năng lực team.", "C": "Đợi có tiền mới đào tạo — chậm.", "D": "Bỏ test tự động — hy sinh chất lượng lâu dài."}, "meo": "Thiếu kỹ năng → cross-train.", "note": ""}, {"n": 74, "stem": "During sprint planning, team members have differing opinions on a feature that delivers business value but fails to provide a long-term solution for the customer.\nHow should the team resolve this?", "opts": {"A": "Refer to the values of the agile framework and the team", "B": "Review the signed customer contract", "C": "Check the sprint priority list", "D": "Submit the problem to the product owner"}, "a": "D", "th": "Team bất đồng về một tính năng có giá trị kinh doanh nhưng không phải giải pháp lâu dài cho khách.", "dung": "PO là người quyết định về giá trị và ưu tiên sản phẩm → đưa vấn đề cho PO quyết.", "sai": {"A": "Giá trị agile không trả lời câu hỏi cụ thể về sản phẩm.", "B": "Hợp đồng không phải nơi giải quyết.", "C": "Danh sách ưu tiên không trả lời bất đồng về giá trị dài hạn."}, "meo": "Tranh luận về GIÁ TRỊ sản phẩm → PO quyết.", "note": ""}, {"n": 75, "stem": "A project team realizes that an important task on the iteration backlog will take more time than originally estimated.\nWhat should the project team do?", "opts": {"A": "Continue working on the task until it is completed", "B": "Remove the task owner from the project team", "C": "Add resources to reduce time to task completion", "D": "Stop working on the task and include it in the next iteration"}, "a": "A", "th": "Một task quan trọng trong iteration backlog sẽ tốn thời gian hơn ước lượng.", "dung": "Task quan trọng → tiếp tục làm cho xong. Ước lượng chỉ là ước lượng; team sẽ rút kinh nghiệm cho lần sau.", "sai": {"B": "Loại người phụ trách — vô lý.", "C": "Thêm người giữa chừng hiếm khi rút ngắn thời gian.", "D": "Dừng task quan trọng sang iteration sau — làm mất giá trị."}, "meo": "Ước lượng sai một task quan trọng → tiếp tục làm.", "note": ""}, {"n": 76, "stem": "An executive sponsor of a new scrum team actively attends scrum ceremonies.\nHow does this benefit the team?", "opts": {"A": "It helps the team to focus on and meet sprint goals", "B": "It reminds the team about who sponsors the project", "C": "It provides high-level project updates to the sponsor", "D": "It helps to quickly resolve issues using the sponsor/s influence"}, "a": "D", "th": "Executive sponsor tích cực tham gia các sự kiện scrum. Lợi ích là gì?", "dung": "Sponsor có quyền lực trong tổ chức → giúp gỡ bỏ trở ngại nhanh (ví dụ ngân sách, nhân sự, phòng ban khác).", "sai": {"A": "Sponsor không giúp team tập trung vào sprint goal — đó là việc của team/SM.", "B": "Nhắc ai là sponsor — vô nghĩa.", "C": "Lợi ích cho sponsor, không phải cho team."}, "meo": "Sponsor = quyền lực → gỡ trở ngại nhanh.", "note": ""}, {"n": 77, "stem": "A legal department representative contacts the scrum master because, while the project's budget has been maintained, it has exceeded its original contracted time and scope.\nWhat should the scrum master do?", "opts": {"A": "Meet with the team to gain alignment with the legal department's need to stay within the contracted time and scope", "B": "Work with the customer to narrow the scope", "C": "Share the project's trajectory with the legal department", "D": "Meet with the legal department to help them understand that the customer and the team are satisfied with the time and deliveries"}, "a": "C", "th": "Phòng pháp chế liên hệ SM vì dự án vượt thời gian và phạm vi hợp đồng ban đầu, dù ngân sách vẫn giữ.", "dung": "Minh bạch: chia sẻ quỹ đạo dự án (trajectory — tiến độ, xu hướng, dự báo) với pháp chế để họ có đủ thông tin xử lý.", "sai": {"A": "Ép team theo hợp đồng cũ — không phù hợp agile.", "B": "SM không tự ý cắt scope với khách.", "D": "\"Khách hài lòng\" không giải quyết mối lo pháp lý."}, "meo": "Câu hỏi từ bên ngoài → minh bạch thông tin.", "note": ""}, {"n": 78, "stem": "An agile project leader notices that the team's velocity has decreased. In examining data provided by team members, the project leader discovers that one team member has been slow to enter story statuses.\nWhat can happen as a result?", "opts": {"A": "The team will be unable to understand the iteration's status", "B": "The team will be unable to judge the project design's validity", "C": "The team cannot give accurate updates to management", "D": "Team collaboration cannot be measured effectively"}, "a": "A", "th": "Velocity giảm; phát hiện một người chậm cập nhật trạng thái story. Hậu quả là gì?", "dung": "Thông tin trạng thái không cập nhật → team không nắm được tình hình thực tế của iteration (burndown, task board sai lệch).", "sai": {"B": "Không liên quan đến tính đúng đắn của thiết kế.", "C": "Có thể đúng nhưng hệ quả trực tiếp, quan trọng hơn là với chính team.", "D": "Cộng tác không được đo bằng trạng thái story."}, "meo": "Cập nhật chậm → team mất tầm nhìn về tình trạng iteration.", "note": ""}, {"n": 79, "stem": "A product owner complains that some of the requirements identified several iterations ago have not been implemented. The product owner wants to know why the status of these requirements was not communicated.\nWhat should the Scrum Master do?", "opts": {"A": "Point out that the team chose to work on other requirements to speed up the project", "B": "Ensure that the product owner reviews the contents of the information radiator", "C": "Ensure that the next sprint planning meeting reviews the satisfaction histogram", "D": "Point out that it is the responsibility of the product owner to clarify requirements"}, "a": "B", "th": "PO phàn nàn một số yêu cầu từ vài iteration trước chưa được làm, và tại sao trạng thái không được thông báo.", "dung": "Thông tin đã có trên information radiator (task board, burnup...). SM đảm bảo PO xem và dùng nó → minh bạch.", "sai": {"A": "Đổ lỗi team.", "C": "Satisfaction histogram đo mức hài lòng của team, không liên quan.", "D": "Đổ lỗi PO."}, "meo": "Hỏi về trạng thái → Information radiator.", "note": ""}, {"n": 80, "stem": "During an iteration review, the agile team asserts that a product is complete because development and review were finished. The product owner disagrees, since the product has not been tested.\nWhat should the agile practitioner do?", "opts": {"A": "Work with the agile team and product owner to agree on the definition of done", "B": "Ask the sponsor to determine whether the product is completed", "C": "Plan another review after the product has been tested", "D": "Add testing to the backlog, and have the product owner reprioritize"}, "a": "A", "th": "Team cho là xong vì đã phát triển và review; PO không đồng ý vì chưa test.", "dung": "Đây là vấn đề không có Definition of Done thống nhất → cùng team và PO thống nhất DoD (ví dụ: phải test xong mới là Done).", "sai": {"B": "Sponsor không quyết định Done.", "C": "Chỉ giải quyết lần này, không giải quyết gốc.", "D": "Test phải là một phần của Done, không phải mục backlog riêng."}, "meo": "Tranh cãi \"xong hay chưa\" → Definition of Done.", "note": ""}, {"n": 81, "stem": "During a sprint review, the product owner identifies a required improvement for a feature's user interface (UI) delivered during the sprint.\nWhat should the product owner do next?", "opts": {"A": "Create a user story for this new improvement and put it in the product backlog for prioritization and validation by the customer", "B": "Create a user story for this new improvement and prioritize it for the next sprint", "C": "Document it as a requirement creep", "D": "Ask the team to take on additional story points to improve the UI"}, "a": "A", "th": "Trong sprint review, PO thấy cần cải thiện UI của tính năng vừa giao.", "dung": "Tạo user story mới, đưa vào product backlog để ưu tiên và xác nhận với khách hàng. Mọi công việc mới đều đi qua backlog.", "sai": {"B": "Tự ý đặt vào sprint sau mà chưa ưu tiên/xác nhận.", "C": "Đây là phản hồi hợp lệ, không phải \"scope creep\".", "D": "Ép team nhận thêm point."}, "meo": "Phát hiện cải tiến → user story mới → backlog → ưu tiên.", "note": ""}, {"n": 82, "stem": "A company is moving into a new space and is determining the best configuration for offices. The management team is also considering moving to an agile process.\nWhat should an agilest give?", "opts": {"A": "Arrange the office space to allow co-location of development teams and centrally located information radiators", "B": "Isolate each development team to reduce all outside distractions", "C": "Ensure management understands the need for isolation to allow for concentration", "D": "Define the agile method the company will be using and implement the office configuration based upon that method"}, "a": "A", "th": "Công ty chuyển văn phòng và đang cân nhắc áp dụng agile. Agilist nên khuyên gì?", "dung": "Bố trí cho team ngồi cùng nhau (co-location) và đặt information radiator ở vị trí trung tâm → tăng giao tiếp trực tiếp, minh bạch.", "sai": {"B": "Cách ly team — đi ngược agile.", "C": "Cách ly team — đi ngược agile.", "D": "Chọn phương pháp trước rồi mới bố trí — co-location là nguyên tắc chung cho mọi phương pháp agile."}, "meo": "Văn phòng agile → co-location + information radiator.", "note": ""}, {"n": 83, "stem": "An agile team member identifies a potential problem within the project team.\nHow should the team's coach react?", "opts": {"A": "Document the problem, escalate to the project manager, and develop a solution for the team", "B": "Add the problem to the backlog and assign resolution to a future iteration", "C": "Instruct the team to try to solve the problem within the team", "D": "Perform root cause analysis and report the problem to the product owner"}, "a": "C", "th": "Một thành viên phát hiện vấn đề tiềm ẩn trong team. Coach phản ứng thế nào?", "dung": "Khuyến khích team tự giải quyết vấn đề trong nội bộ — phát huy tự tổ chức.", "sai": {"A": "Coach tự giải quyết và leo thang.", "B": "Đẩy về tương lai — vấn đề có thể lớn lên.", "D": "Báo PO — không phải việc của PO."}, "meo": "Vấn đề trong team → team tự giải quyết.", "note": ""}, {"n": 84, "stem": "Stakeholders are displeased with the latest release of a product's software. While most stakeholders attended every sprint review, they were otherwise largely uninvolved in the project.\nWhat should the agile practitioner have done to ensure stakeholder satisfaction?", "opts": {"A": "Communicated early and often, as outlined in the communications matrix", "B": "Ensured engagement among stakeholders and the product owner", "C": "Conducted additional stakeholder reviews and demos", "D": "Worked with the product owner to prioritize user stories"}, "a": "B", "th": "Stakeholder không hài lòng với release mới; họ có dự sprint review nhưng ngoài ra gần như không tham gia.", "dung": "Cần đảm bảo stakeholder và PO gắn kết (engagement) liên tục, không chỉ ở review — để nhu cầu của họ được phản ánh vào backlog.", "sai": {"A": "Giao tiếp nhiều theo ma trận truyền thông vẫn là một chiều.", "C": "Thêm review/demo — họ đã dự review rồi, vấn đề là thiếu gắn kết.", "D": "Ưu tiên story — thiếu ý kiến stakeholder thì ưu tiên vẫn sai."}, "meo": "Stakeholder không hài lòng dù có dự review → thiếu ENGAGEMENT với PO.", "note": ""}, {"n": 85, "stem": "An agile project manager notices that the product manager manages team member's day-to-day tasks in a way that distracts them from their core responsibilities.\nIn addition, the team believes that their questions on product backlog prioritization are not being answered on time.\nWhat should the agile practitioner do?", "opts": {"A": "Discuss and address this in the iteration retrospective", "B": "Let the product owner know it is the project manager's responsibility to drive a ream's tasks", "C": "Discuss the roles and responsibilities of the project team with the product owner", "D": "Ask the product owner to work extra hours to answer the team's questions"}, "a": "A", "th": "Product manager quản lý việc hàng ngày của team gây phân tâm; câu hỏi về ưu tiên backlog không được trả lời kịp.", "dung": "Đưa ra thảo luận và giải quyết trong retrospective — nơi team (bao gồm PO) xem xét cách làm việc và cải tiến.", "sai": {"B": "Tranh giành quyền lãnh đạo — không đúng agile.", "C": "Có thể hữu ích nhưng chỉ bàn riêng với PO, không có team.", "D": "Bắt PO làm thêm giờ — không bền vững."}, "meo": "Vấn đề về cách làm việc giữa các vai trò → retrospective.", "note": "Một số nguồn chọn C (làm rõ vai trò với PO). Đáp án của file là A."}, {"n": 86, "stem": "An agile team member from a cross-functional team has been unable to complete assignments due to tasks assigned by the functional manager.\nWhat should the scrum master do?", "opts": {"A": "Dismiss the team member", "B": "Discuss the situation with the functional manager", "C": "Report the functional manager to the project sponsor", "D": "Demand that the functional manager respect the project charter"}, "a": "B", "th": "Một thành viên cross-functional không hoàn thành việc vì quản lý chức năng giao thêm việc.", "dung": "SM trao đổi trực tiếp với quản lý chức năng để gỡ bỏ trở ngại — vai trò servant leader.", "sai": {"A": "Sa thải — vô lý.", "C": "Tố cáo lên sponsor — leo thang quá sớm.", "D": "\"Yêu cầu\" mang tính đối đầu."}, "meo": "Trở ngại từ bên ngoài → SM trao đổi trực tiếp để gỡ.", "note": ""}, {"n": 87, "stem": "During a mature agile team's planning meeting, a team member proposes a new framework that would considerably reduce implementation time. However, the team lacks the confidence to try the new framework.\nTo help the team gain confidence, what should the agile practitioner suggest?", "opts": {"A": "Develop a spike", "B": "Create an Ishikawa diagram", "C": "Perform a pre-mortem analysis", "D": "Complete a variance and trend analysis"}, "a": "A", "th": "Thành viên đề xuất framework mới giảm nhiều thời gian; team chưa tự tin thử.", "dung": "Spike là thử nghiệm ngắn, có time box để khám phá kỹ thuật mới → giảm bất định, tạo niềm tin.", "sai": {"B": "Ishikawa phân tích nguyên nhân gốc rễ.", "C": "Pre-mortem là tưởng tượng thất bại để tìm rủi ro.", "D": "Variance & trend là phân tích số liệu."}, "meo": "Công nghệ mới / chưa chắc → Spike.", "note": ""}, {"n": 88, "stem": "The team is in the middle of an iteration and there is an urgent request for a small change to be introduced to the committed scope. Unless this change is accepted, there is no value to the customers during this iteration.\nWhat must the agile practitioner do?", "opts": {"A": "Add the new change request as a new user story in the product backlog for the upcoming iteration", "B": "Evaluate the impact of the change request and let the team and product owner decide and re-prioritize based on value", "C": "Recommend cancelling the current iteration and plan the change request into the next iteration", "D": "Recommend that the product owner add this change request as a user story to the backlog for the current iteration"}, "a": "B", "th": "Giữa iteration có yêu cầu thay đổi nhỏ khẩn cấp; nếu không làm thì iteration này không có giá trị cho khách.", "dung": "Đánh giá tác động, để team và PO quyết định và ưu tiên lại dựa trên giá trị. Agile linh hoạt, nhưng quyết định phải chung.", "sai": {"A": "Đợi iteration sau → iteration này không có giá trị.", "C": "Hủy iteration — quá cực đoan với thay đổi nhỏ.", "D": "Thêm vào ngay mà không đánh giá tác động."}, "meo": "Thay đổi giữa iteration → đánh giá tác động + team & PO quyết.", "note": ""}, {"n": 89, "stem": "During a review session, an agile team presented done requirements to a group of stakeholders. Stakeholder feedback indicated that the done requirements failed to meet most pressing needs and provide value.\nWhat should the team have done to prevent this?", "opts": {"A": "Reprioritized requirements prior to committing to iteration work", "B": "Ensured that requirements remained stable during the iteration cycle", "C": "Had stakeholders focus on items created after the product backlog was initially built", "D": "Worked on features rather than a set of components"}, "a": "A", "th": "Các yêu cầu \"done\" không đáp ứng nhu cầu cấp thiết nhất của stakeholder.", "dung": "Lẽ ra phải ưu tiên lại yêu cầu trước khi cam kết iteration → làm cái giá trị nhất trước.", "sai": {"B": "Giữ yêu cầu ổn định không đảm bảo đúng nhu cầu.", "C": "Chỉ xem item tạo sau — vô lý.", "D": "Feature vs component không phải vấn đề chính."}, "meo": "Làm không đúng nhu cầu cấp thiết → ưu tiên lại trước khi cam kết.", "note": ""}, {"n": 90, "stem": "A member of a project's development team approaches the team lead and requests database administrator training. The team member believes that their inability to handle this work and to rely on outside specialists is impacting team velocity.\nWhat should the agile team lead do?", "opts": {"A": "Send the member to training", "B": "Ask the outside specialists if database administration is required from the team", "C": "Send one member to training only after asking the team if there is an issue with the current work flow", "D": "Wait until all members of the team can attend training"}, "a": "C", "th": "Thành viên xin đào tạo DBA vì nghĩ việc phụ thuộc chuyên gia ngoài làm giảm velocity.", "dung": "Hỏi team xem có thực sự là vấn đề trong workflow không (dữ liệu, ý kiến chung), rồi mới gửi 1 người đi đào tạo → quyết định dựa trên team.", "sai": {"A": "Gửi đi ngay khi chưa xác nhận vấn đề.", "B": "Hỏi chuyên gia bên ngoài — không phải người hiểu workflow team.", "D": "Đợi tất cả cùng đi — chậm, tốn kém."}, "meo": "Đề xuất của một người → xác nhận với team trước.", "note": ""}, {"n": 91, "stem": "What role should a servant leader perform to reduce team distractions and improve progress toward project goals?", "opts": {"A": "Managing: To ensure compliance with the project plan", "B": "Mentoring: To share their knowledge with the team", "C": "Controlling: To ensure compliance with the scope, budget, and schedule", "D": "Auditing: To ensure adherence to organizational compliance policies"}, "a": "B", "th": "Servant leader nên đóng vai trò gì để giảm phân tâm và cải thiện tiến độ?", "dung": "Mentoring — chia sẻ kiến thức, hướng dẫn team. Đây là vai trò phù hợp nhất với servant leader trong các lựa chọn.", "sai": {"A": "Managing để tuân thủ kế hoạch — quản lý truyền thống.", "C": "Controlling — kiểm soát, không phải phục vụ.", "D": "Auditing — kiểm toán, không phù hợp."}, "meo": "Servant leader: mentor, coach, facilitate — không control.", "note": ""}, {"n": 92, "stem": "During a retrospective meeting, a team develops a large list of initiatives. All will have a positive impact and improve team performance.\nWhat should the agile coach do next?", "opts": {"A": "Positively acknowledge the list and share it with management", "B": "Immediately have the team implement the initiatives", "C": "Help the team choose one or two initiatives for immediate implementation", "D": "Ask the team to choose and implement the most complex initiative"}, "a": "C", "th": "Retrospective tạo ra danh sách dài các sáng kiến cải tiến, đều tốt.", "dung": "Giúp team chọn 1–2 sáng kiến để thực hiện ngay — tập trung, khả thi, đo được kết quả (cải tiến từng bước nhỏ).", "sai": {"A": "Gửi lên quản lý — không hành động.", "B": "Làm hết cùng lúc — quá tải, không đo được hiệu quả.", "D": "Chọn cái phức tạp nhất — rủi ro."}, "meo": "Retro → chọn 1-2 cải tiến làm ngay.", "note": ""}, {"n": 93, "stem": "A product owner concludes that the majority of a project's value can be delivered by completing only the first half of the prioritized backlog.\nWhat should the product owner do next?", "opts": {"A": "Remove the second half of the backlog, and communicate their decision in the next backlog grooming meeting", "B": "Reprioritize backlog items to future iterations", "C": "Work with the team to deploy the first half of the backlog to ensure that value is realized", "D": "Meet with project stakeholders to review backlog and determine if the scope should be adjusted"}, "a": "C", "th": "PO kết luận phần lớn giá trị nằm ở nửa đầu backlog đã ưu tiên.", "dung": "Cùng team triển khai nửa đầu backlog để hiện thực hóa giá trị sớm — giao giá trị sớm là nguyên tắc cốt lõi.", "sai": {"A": "Xóa nửa sau ngay — có thể còn giá trị, quá vội.", "B": "Đẩy hết sang tương lai — không có ý nghĩa.", "D": "Có thể hợp lý, nhưng ưu tiên trước hết là hiện thực hóa giá trị."}, "meo": "Phần lớn giá trị ở phần đầu → deploy sớm để thu giá trị.", "note": "Một số nguồn chọn D (họp stakeholder để điều chỉnh scope). Đáp án của file là C."}, {"n": 94, "stem": "During the review session, the product owner discovers that the user interface has a response time of 10 seconds. The non-functional requirements state that it should respond in less than two seconds. The team complains that this requirement was not communicated to them.\nWhat should have been done to avoid this?", "opts": {"A": "A comprehensive user story with all non-functional requirements should have been created", "B": "Non-functional requirements should have been added to the acceptance criteria", "C": "Non-functional requirements should have been added to the definition of done", "D": "A team review of the scope of work should have been conducted"}, "a": "C", "th": "UI phản hồi 10 giây trong khi NFR yêu cầu dưới 2 giây; team nói không được thông báo.", "dung": "NFR áp dụng cho mọi story (hiệu năng, bảo mật...) nên đưa vào Definition of Done → mọi story đều phải đạt mới là xong.", "sai": {"A": "User story \"toàn diện\" chứa mọi NFR — không thực tế.", "B": "Acceptance criteria là riêng từng story; NFR chung nên vào DoD.", "D": "Review scope không đảm bảo NFR được kiểm tra."}, "meo": "NFR áp dụng chung → Definition of Done.", "note": ""}, {"n": 95, "stem": "Midway through a sprint, a scrum team member advises the team of a new requirement that may change the initial scope.\nWhat should the team do?", "opts": {"A": "Work on requirements that the product owner may have overlooked", "B": "Record the scope creep in the change management log", "C": "Add the new requirement to the product backlog", "D": "Ask the scrum master to secure additional time and resources"}, "a": "C", "th": "Giữa sprint, thành viên báo có yêu cầu mới có thể đổi phạm vi.", "dung": "Đưa yêu cầu mới vào product backlog để PO ưu tiên. Không thay đổi sprint đang chạy.", "sai": {"A": "Tự làm yêu cầu mà PO có thể bỏ sót — vượt quyền.", "B": "Log change management — quy trình truyền thống.", "D": "Xin thêm thời gian/người — không cần."}, "meo": "Yêu cầu mới → Product backlog.", "note": ""}, {"n": 96, "stem": "A product owner, new to the role, is very enthusiastic about an agile project with an energetic team.\nWhat should be done first to ensure successful delivery of the product?", "opts": {"A": "Hold a meeting with the team and the product owner to develop the team charter, working agreement, guiding principles, and product vision", "B": "Ask the product owner to create the project vision and charter, and then discuss the guiding principles with the team", "C": "Hold a meeting during which the team can present the project charter, high-level project plan, and team values to the product owner", "D": "Send the product owner to format product owner training where the product owner can learn how to create a product vision"}, "a": "A", "th": "PO mới rất nhiệt tình với dự án agile và team năng động. Việc đầu tiên để giao sản phẩm thành công?", "dung": "Họp cả team và PO để cùng xây dựng team charter, working agreement, nguyên tắc chung và product vision → nền tảng cộng tác, mọi người cùng hiểu mục tiêu.", "sai": {"B": "PO tự viết vision và charter — thiếu sự tham gia của team.", "C": "Team trình bày cho PO — một chiều, ngược vai.", "D": "Đào tạo PO tốt nhưng không phải bước đầu tiên để cả team bắt đầu."}, "meo": "Khởi đầu dự án → cả team cùng làm charter + vision.", "note": ""}, {"n": 97, "stem": "During a current sprint, a team member asks permission from the scrum master to investigate an alternative design approach.\nWhat should the scrum master do?", "opts": {"A": "Discourage the team member from deviating from the plan and document the request during the retrospective", "B": "Encourage the team member to research the issue and present the findings during the retrospective", "C": "Discourage the team member from using experimentation/spikes unless it is fully developed and accounts for a variety of use cases", "D": "Encourage the team member to use experimentation/spikes for continuous improvement and help the team understand why it is important"}, "a": "D", "th": "Giữa sprint, thành viên xin SM được tìm hiểu một hướng thiết kế khác.", "dung": "Khuyến khích dùng thử nghiệm/spike để cải tiến liên tục và giúp team hiểu tầm quan trọng của việc thử nghiệm.", "sai": {"A": "Ngăn cản thử nghiệm — đi ngược tinh thần cải tiến.", "B": "Đợi trình bày ở retro — retro là về quy trình, không phải kết quả kỹ thuật.", "C": "Đòi thử nghiệm phải \"hoàn chỉnh\" — mâu thuẫn với bản chất thử nghiệm."}, "meo": "Muốn thử cách mới → khuyến khích spike/experiment.", "note": ""}, {"n": 98, "stem": "The scrum master for a large project must provide an estimate of what can be delivered in six months.\nWhat should the scrum master do?", "opts": {"A": "Commit to a specific feature set for delivery", "B": "Explain that a commitment will be provided after planning", "C": "Have the team estimate in story points to commit to a specific set of features", "D": "Use the team's historical velocity to calculate a range of features that can be delivered"}, "a": "D", "th": "SM dự án lớn phải ước tính những gì giao được trong 6 tháng.", "dung": "Dùng velocity lịch sử để tính ra một KHOẢNG (range) tính năng có thể giao — dự báo thực tế, có độ bất định.", "sai": {"A": "Cam kết một tập tính năng cố định — không phản ánh bất định.", "B": "Từ chối trả lời cho đến khi lập kế hoạch — không hữu ích.", "C": "Story point để cam kết cụ thể — vẫn là cam kết cứng."}, "meo": "Dự báo dài hạn → velocity lịch sử → khoảng (range).", "note": ""}, {"n": 99, "stem": "A member of the development team is working on a prioritized non-functional requirement involving integrating with a 3rd party system. This integration has not been done before on the project.\nWhat should the project leader suggest?", "opts": {"A": "Develop and document a detailed architectural design, peer review with the development team, and implement/test", "B": "Develop the functional requirements of the solution first before any non-functional requirement, as they provide more customer value", "C": "Discuss the integration requirement with the product owner and negotiate it to be lower on the backlog to focus on the minimal marketable feature", "D": "Develop and test the implementation approach and demonstrate it at the next sprint review to collect feedback"}, "a": "D", "th": "Một NFR đã ưu tiên: tích hợp với hệ thống bên thứ 3, chưa từng làm trong dự án.", "dung": "Phát triển và thử nghiệm cách tích hợp, demo ở sprint review để lấy phản hồi — học bằng làm, phản hồi sớm.", "sai": {"A": "Thiết kế chi tiết, tài liệu đầy đủ trước — kiểu waterfall.", "B": "Đẩy NFR xuống sau — trong khi nó đã được ưu tiên.", "C": "Đàm phán hạ ưu tiên — né rủi ro, không xử lý."}, "meo": "Việc mới, rủi ro → làm thử + demo + feedback.", "note": ""}, {"n": 100, "stem": "During a retrospective, the agile practitioner discovers that a team member's process improvement idea has worsened the outcome.\nWhat should the agile practitioner do?", "opts": {"A": "Commend the team on trying the idea, then encourage discussion regarding alternatives", "B": "Ask a manager to direct the team on fixing the process", "C": "Encourage the team to continue executing the idea to see if it improves", "D": "Privately speak with the team member to convey that their idea worsened the outcome"}, "a": "A", "th": "Trong retro phát hiện ý tưởng cải tiến của một người làm kết quả tệ hơn.", "dung": "Khen team vì đã dám thử, rồi khuyến khích thảo luận phương án khác → giữ an toàn tâm lý, thất bại là học hỏi.", "sai": {"B": "Nhờ quản lý chỉ đạo — mất tự tổ chức.", "C": "Cứ tiếp tục dù tệ hơn — lãng phí.", "D": "Nói riêng với người đó là ý tưởng của họ làm tệ — đổ lỗi cá nhân."}, "meo": "Thử nghiệm thất bại → khen dám thử, tìm cách khác.", "note": ""}, {"n": 101, "stem": "Early in a project, stakeholder analysis is performed; however, an organizational restructure redefines key roles.\nWhat should the project team do?", "opts": {"A": "Note the changes to the restructure and roles that affect team activities", "B": "Use direct engagement and two-way conversation to update the stakeholder analysis for any new stakeholder requirements", "C": "Email a copy of the project vision to those redefined for key roles and ask if they need to be involved in the project", "D": "Obtain a copy of the redefined key roles to update the stakeholder analysis"}, "a": "B", "th": "Đã phân tích stakeholder từ đầu, nhưng tổ chức tái cơ cấu, vai trò chính thay đổi.", "dung": "Gặp trực tiếp, trao đổi hai chiều với người ở vai trò mới để cập nhật phân tích stakeholder và nhu cầu mới.", "sai": {"A": "Chỉ ghi nhận thay đổi — chưa hành động.", "C": "Email vision và hỏi họ có muốn tham gia — thụ động.", "D": "Lấy danh sách vai trò mới — chưa đủ, cần trao đổi trực tiếp."}, "meo": "Stakeholder thay đổi → engage trực tiếp, hai chiều.", "note": ""}, {"n": 102, "stem": "A team member has spent 5 days on a spike and the first set of experiments has not been successful. The issue is the development team member has determined a short-term rather than a long-term solution.\nWhat should the project leader do?", "opts": {"A": "Assign the spike to another resource to continue research for the long-term solution", "B": "Re-estimate the spike, encourage experimentation and collaborate with the team", "C": "Stop experimentation and negotiate the short-term solution with the customer", "D": "Schedule a root-cause analysis with the development team on the main issues with the spike"}, "a": "B", "th": "Một người làm spike 5 ngày, thí nghiệm đầu chưa thành công; mới tìm ra giải pháp ngắn hạn chứ chưa dài hạn.", "dung": "Ước lượng lại spike, khuyến khích tiếp tục thử nghiệm và cộng tác với team → học hỏi tiếp.", "sai": {"A": "Đổi người — mất kiến thức đã tích lũy.", "C": "Dừng và chấp nhận giải pháp ngắn hạn — không đạt mục tiêu.", "D": "Root cause analysis — chưa cần, đây là thử nghiệm bình thường."}, "meo": "Spike chưa xong → re-estimate + tiếp tục + cộng tác.", "note": ""}, {"n": 103, "stem": "An agile team notices that the same problems continue to occur during multiple iterations. Several team members have suggestions to fix the problem.\nWhat is the proper agile approach to handle this?", "opts": {"A": "Hold frequent retrospectives and share the responsibility for making changes", "B": "Understand that this is the nature of innovative business and strive to work harder", "C": "Collect team member feedback and discuss them privately with the product owner", "D": "Conduct a team-building exercise to increase trust among the team members"}, "a": "A", "th": "Các vấn đề giống nhau cứ lặp lại qua nhiều iteration; nhiều người có đề xuất sửa.", "dung": "Tổ chức retrospective thường xuyên và chia sẻ trách nhiệm thực hiện thay đổi trong team → vòng cải tiến liên tục.", "sai": {"B": "Chấp nhận và cố làm chăm hơn — không giải quyết.", "C": "Thảo luận riêng với PO — bỏ qua team.", "D": "Team building tăng niềm tin nhưng không xử lý vấn đề lặp lại; team đã có đề xuất, vấn đề không phải thiếu tin tưởng."}, "meo": "Vấn đề lặp lại + có đề xuất → retrospective + cùng chịu trách nhiệm.", "note": "File ghi đáp án D. Theo nguyên tắc agile, A phù hợp hơn và là đáp án phổ biến ở nhiều nguồn."}, {"n": 104, "stem": "An experienced product owner presents the epics and corresponding stories during a release planning session with the established team. The executive sponsor asks the team when the features will be delivered.\nWhat should the agile team do?", "opts": {"A": "Evaluate how much can be delivered based on the Scrum Master's estimation", "B": "Identify a set of user stories based on the team's velocity", "C": "Initiate an estimation session", "D": "Consult historical data for project completion"}, "a": "B", "th": "Team đã ổn định (established); PO trình bày epic và story trong release planning; sponsor hỏi khi nào giao.", "dung": "Team đã ổn định nên có velocity → chọn tập story theo velocity để dự báo thời điểm giao.", "sai": {"A": "Dựa trên ước lượng của SM — SM không ước lượng.", "C": "Mở buổi ước lượng — có thể cần, nhưng câu hỏi là \"khi nào\", cần velocity để trả lời.", "D": "Dữ liệu hoàn thành của dự án cũ — không phản ánh dự án này."}, "meo": "Team ổn định + \"khi nào xong?\" → dùng velocity.", "note": "File ghi đáp án D. Với team đã ổn định, B (dựa trên velocity) hợp lý hơn; nhiều nguồn chọn B."}, {"n": 105, "stem": "An agile team is planning the next iteration for a product release that has accumulated technical debt.\nWhat should the team do?", "opts": {"A": "Add code cleanup activities to the product backlog and request prioritization by the product owner", "B": "Add code cleanup activities to the next iteration and request clarification from the product owner", "C": "Add code cleanup activities to the next iteration and ask the product owner to end the current iteration", "D": "Add code cleanup activities to the next release backlog and request documentation from the product owner"}, "a": "A", "th": "Lập kế hoạch iteration cho release đã tích lũy nợ kỹ thuật.", "dung": "Thêm hoạt động dọn code vào product backlog và nhờ PO ưu tiên → minh bạch, cân bằng với giá trị kinh doanh.", "sai": {"B": "Tự đưa vào iteration mà chưa qua ưu tiên.", "C": "Yêu cầu PO kết thúc iteration hiện tại — quá đáng.", "D": "Đòi PO cung cấp tài liệu — không liên quan."}, "meo": "Nợ kỹ thuật → backlog + PO ưu tiên.", "note": ""}, {"n": 106, "stem": "An agile project manager is planning the initial scope, schedule, and cost range estimates on a new project. The team will be using Kanban to control work.\nWhat metrics should the team use to measure performance?", "opts": {"A": "Lead time, throughput, and due date performance", "B": "Work in progress limits, Kanban board, and time boxes", "C": "Work item types, sprint cadences, and defect classes", "D": "Burndown charts, scatter diagrams, and throughput"}, "a": "A", "th": "Team dùng Kanban; cần chỉ số đo hiệu suất.", "dung": "Kanban đo dòng chảy: lead time (thời gian từ yêu cầu đến giao), throughput (số việc hoàn thành/khoảng thời gian) và due date performance (tỷ lệ đúng hạn).", "sai": {"B": "WIP limit, board, time box là công cụ/quy tắc, không phải chỉ số.", "C": "Sprint cadence thuộc Scrum.", "D": "Burndown chart đặc trưng của Scrum."}, "meo": "Kanban metrics → lead time, cycle time, throughput.", "note": ""}, {"n": 107, "stem": "During project inception, an agile practitioner engages the stakeholder to ensure alignment on the project's strategy and vision. The stakeholder asks for detailed requirements, design, and delivery plans.\nWhat should the agile practitioner do?", "opts": {"A": "Provide all information requested by the stakeholder", "B": "Set expectations regarding the appropriate level of details requested during this stage", "C": "Inform the stakeholder that no detailed documents are provided using agile practices", "D": "Ask the team to supply the information to the stakeholder"}, "a": "B", "th": "Giai đoạn khởi đầu dự án, stakeholder đòi yêu cầu chi tiết, thiết kế, kế hoạch giao hàng.", "dung": "Đặt kỳ vọng về mức độ chi tiết phù hợp ở giai đoạn này — agile chi tiết hóa dần (progressive elaboration).", "sai": {"A": "Cung cấp tất cả — không thể và lãng phí.", "C": "\"Agile không có tài liệu\" — sai, agile có tài liệu vừa đủ.", "D": "Đẩy cho team — không giải quyết kỳ vọng."}, "meo": "Đòi chi tiết quá sớm → set expectations.", "note": ""}, {"n": 108, "stem": "A product owner feels that the last sprint failed to sufficiently deliver what was valuable to their organization's overall project goals.\nWhat should the scrum master mention at the next retrospective?", "opts": {"A": "Solutions to project problems that were built into the last sprint", "B": "Problems that arose", "C": "Solutions that saved the organizations the most time and money", "D": "Problems that were solved"}, "a": "B", "th": "PO thấy sprint trước không giao đủ giá trị. SM nên nêu gì ở retro tới?", "dung": "Nêu các vấn đề đã phát sinh (problems that arose) → team phân tích nguyên nhân và tìm cải tiến.", "sai": {"A": "Tập trung vào giải pháp/thành công — không giúp hiểu vì sao giá trị chưa đủ.", "C": "Tập trung vào giải pháp/thành công — không giúp hiểu vì sao giá trị chưa đủ.", "D": "Tập trung vào giải pháp/thành công — không giúp hiểu vì sao giá trị chưa đủ."}, "meo": "Retro sau sprint kém → nhìn vào vấn đề đã xảy ra.", "note": ""}, {"n": 109, "stem": "A new product owner needs to manage the backlog of a high-visibility, fast-moving project that is consuming a considerable amount of time.\nWhat should the product owner do?", "opts": {"A": "Schedule regular meetings with the scrum team to write, groom, and size user stories", "B": "Focus on stores based on the highest number of story points to first address those items with the highest value", "C": "Seek regular input from project stakeholders, and reflect this input in the backlog's priorities", "D": "Schedule in-person, monthly meetings with key stakeholders to review the project's progress"}, "a": "C", "th": "PO mới quản lý backlog của dự án nhanh, nổi bật, tốn nhiều thời gian.", "dung": "Thường xuyên lấy ý kiến stakeholder và phản ánh vào thứ tự ưu tiên backlog → backlog luôn đúng giá trị.", "sai": {"A": "Họp team để viết/groom/size story — tốt nhưng chưa có góc nhìn stakeholder.", "B": "Ưu tiên theo số point cao nhất — point là công sức, không phải giá trị.", "D": "Họp hàng tháng — quá thưa cho dự án nhanh."}, "meo": "Ưu tiên backlog → input stakeholder thường xuyên.", "note": ""}, {"n": 110, "stem": "A team identifies the number of threats and lists them in the order in which they were identified. After analyzing a cause-and effect diagram, the ownership of the threats and their treatment is assigned, and a number of risk cards are placed on the Kanban board.\nWhat approach should be used to manage these threats?", "opts": {"A": "Create a risk register detailing the threats, their causes, and their treatment strategies, and complete ownership to provide together risk control and a stakeholder", "B": "Focus on the threats during the daily stand up and ensure they are visible to the entire team and other interested parties", "C": "Prioritize the risks based on their criticality and timing, and track actions to closure", "D": "Ensure that the prioritization of threats is complete, and that ownership actions are assigned and visible to everyone"}, "a": "D", "th": "Team đã xác định mối đe dọa, phân tích nhân quả, gán chủ sở hữu, đặt risk card lên Kanban.", "dung": "Đảm bảo việc ưu tiên mối đe dọa hoàn tất, chủ sở hữu và hành động được gán và mọi người đều thấy — minh bạch, hoàn thiện quy trình.", "sai": {"A": "Risk register chi tiết — nặng tài liệu.", "B": "Chỉ tập trung ở stand-up — chưa đủ.", "C": "Ưu tiên và theo dõi — gần đúng nhưng thiếu yếu tố minh bạch cho mọi người."}, "meo": "Rủi ro trong agile → ưu tiên + chủ sở hữu + hiển thị rõ.", "note": ""}, {"n": 112, "stem": "The agile team disagrees with the business stakeholders on completing some epics.\nWhat could help eliminate misunderstandings?", "opts": {"A": "Agree on requirements with all stakeholders", "B": "Begin planning every four iterations", "C": "Consider previous sprint demo feedback when planning the next sprint", "D": "Include the reasons for the project in the contract"}, "a": "C", "th": "Team bất đồng với stakeholder về việc hoàn thành một số epic.", "dung": "Dùng phản hồi từ demo sprint trước khi lập kế hoạch sprint sau → điều chỉnh liên tục theo phản hồi thật.", "sai": {"A": "Thống nhất yêu cầu với tất cả ngay từ đầu — kiểu waterfall.", "B": "Lập kế hoạch 4 iteration một lần — thưa, chậm phản hồi.", "D": "Ghi lý do vào hợp đồng — không xóa hiểu lầm."}, "meo": "Hiểu lầm → dùng feedback demo để lập kế hoạch.", "note": ""}, {"n": 113, "stem": "A customer and a product delivery team meet to discuss a product's attributes, goals, expectations, hypothesis, and high-level needs.\nWhat is a benefit of this meeting?", "opts": {"A": "The team will learn how its contribution will create product value", "B": "It will enable team acceptance of client priorities", "C": "It will enable the team to see the entire project in one glance", "D": "It will enable the team to ask any questions to the customer upfront"}, "a": "A", "th": "Khách hàng và team gặp nhau bàn về thuộc tính, mục tiêu, kỳ vọng, giả thuyết, nhu cầu cấp cao của sản phẩm.", "dung": "Team hiểu được đóng góp của mình tạo ra giá trị thế nào → có động lực và ra quyết định tốt hơn.", "sai": {"B": "Không chỉ để \"chấp nhận\" ưu tiên.", "C": "Nhìn toàn bộ dự án một lần — không thực tế.", "D": "Hỏi trước mọi câu — không phải mục đích chính."}, "meo": "Họp vision/mục tiêu với khách → team hiểu GIÁ TRỊ.", "note": ""}, {"n": 114, "stem": "When introducing agile processes to a company, a quality assurance (QA) manager resists and believes that the switch to agile will remove quality controls and documents.\nHow should the agile practitioner address this concern?", "opts": {"A": "Educate the QA manager that in agile, quality is integrated from the beginning to end of the project", "B": "Write backlog items that include QA as part of the description", "C": "Ask for the current QA documents and incorporate them into the technical debt backlog", "D": "Ask the product owner to write tests and QA controls into the acceptance criteria"}, "a": "A", "th": "Quản lý QA phản đối agile vì sợ mất kiểm soát chất lượng và tài liệu.", "dung": "Giải thích (educate) rằng trong agile chất lượng được tích hợp từ đầu đến cuối dự án (built-in quality, test liên tục).", "sai": {"B": "Ghi QA vào mô tả backlog — không giải quyết mối lo.", "C": "Đưa tài liệu QA vào nợ kỹ thuật — sai khái niệm.", "D": "PO viết test — không phải vai trò chính."}, "meo": "Người phản đối do hiểu lầm → EDUCATE.", "note": ""}, {"n": 115, "stem": "While struggling to take ownership of delivery, an agile team fails to keep up with its sprint commitments.\nWhat should the agile coach do?", "opts": {"A": "Work with the sponsor to develop team expectations", "B": "Provide the customer with a list of deliverables and obtain agreement", "C": "Encourage the team to more frequently interact with all stakeholders", "D": "Work on finishing upfront product design rather than comprehensive documentation"}, "a": "C", "th": "Team chưa làm chủ việc giao hàng, không theo kịp cam kết sprint.", "dung": "Khuyến khích team tương tác thường xuyên hơn với stakeholder → hiểu giá trị, tăng tinh thần trách nhiệm và làm chủ.", "sai": {"A": "Sponsor đặt kỳ vọng — từ trên xuống.", "B": "Danh sách deliverable cho khách — không giải quyết tinh thần làm chủ.", "D": "Thiết kế upfront — đi ngược agile."}, "meo": "Thiếu ownership → kết nối team với stakeholder.", "note": ""}, {"n": 116, "stem": "During a team meeting, members who are subject matter experts (SMEs) mention that they are continuously working on repetitive tasks, which has lowered motivation.\nWhat should the agile practitioner do?", "opts": {"A": "Organize a team-building activity to improve team morale", "B": "Have team members work in pairs to learn from each other and develop new skills", "C": "Ask team members to perform a value stream analysis of their activities", "D": "Add more resources to the team to help with tasks"}, "a": "C", "th": "SME phải làm việc lặp lại liên tục, động lực giảm.", "dung": "Phân tích value stream giúp nhận diện việc lặp lại không tạo giá trị → loại bỏ/tự động hóa.", "sai": {"A": "Team building chỉ tạm thời.", "B": "Pair học kỹ năng mới — không giải quyết việc lặp lại.", "D": "Thêm người — vẫn làm việc nhàm chán."}, "meo": "Việc lặp lại, lãng phí → Value stream analysis.", "note": ""}, {"n": 117, "stem": "An agile team is working on a new product. To ensure that all unknown issues are clarified before committing to the scope, the team plans to work only on spike user stories for the next three sprints.\nWhat should an agile coach do in this situation?", "opts": {"A": "Ensure that the spikes identify the risks early in the project to increase the chances of success", "B": "Ensure that the business sponsor accepts the proposal and agrees to fund the additional spike sprints", "C": "Recommend that, in the first sprint, user stones with higher priority be executed in addition to the spike", "D": "Support the decision, because release planning will be improved, and the product backlog can be better groomed after all spikes are executed"}, "a": "A", "th": "Team định chỉ làm spike trong 3 sprint tới để làm rõ mọi điều chưa biết trước khi cam kết scope.", "dung": "Coach đảm bảo spike giúp nhận diện rủi ro sớm → tăng khả năng thành công. Spike là để giảm bất định/rủi ro.", "sai": {"B": "Sponsor chấp nhận và chi thêm — không phải vai trò của coach.", "C": "Có thể hợp lý nhưng đề không hỏi về việc trộn story.", "D": "Ủng hộ hoàn toàn — 3 sprint chỉ spike, không giao giá trị là rủi ro."}, "meo": "Spike → mục đích là giảm rủi ro sớm.", "note": ""}, {"n": 119, "stem": "What can an agile team use to prioritize stories?", "opts": {"A": "Planning poker technique", "B": "Weighted average calculation", "C": "Risk-value quadrant", "D": "INVEST scale"}, "a": "C", "th": "Team có thể dùng gì để ưu tiên story?", "dung": "Risk-value quadrant (ma trận rủi ro – giá trị) dùng để ưu tiên.", "sai": {"A": "Planning poker để ước lượng.", "B": "Trung bình có trọng số — không phải kỹ thuật ưu tiên agile chuẩn.", "D": "INVEST là tiêu chí story tốt."}, "meo": "Ưu tiên → MoSCoW, Kano, Risk-Value; Ước lượng → Planning poker.", "note": ""}, {"n": 120, "stem": "During a daily stand up, the tester engages the developer in a discussion about what will be tested during unit testing versus regression testing.\nWhat should the scrum master do?", "opts": {"A": "Ask the tester and developer to discuss it after the meeting, since it is not a part of the daily stand up", "B": "Encourage the discussion to resolve impediments", "C": "After the meeting, escalate this issue to the tester's supervisor to ensure that this does not reoccur", "D": "Ask more questions about the testing techniques to obtain clarification on team efforts for quality improvements"}, "a": "A", "th": "Trong daily stand-up, tester và dev thảo luận về test unit vs regression.", "dung": "Stand-up chỉ 15 phút, mỗi người trả lời 3 câu hỏi. Thảo luận chi tiết nên để sau buổi họp.", "sai": {"B": "Khuyến khích thảo luận làm stand-up kéo dài.", "C": "Leo thang lên quản lý — vô lý.", "D": "Hỏi thêm làm buổi họp dài hơn."}, "meo": "Thảo luận chi tiết trong stand-up → \"parking lot\", nói sau.", "note": ""}, {"n": 121, "stem": "A team is delivering work as per the sprint plan, and team velocity is stabilized. However, at the end of the release, the customer is dissatisfied with project quality.\nWhat should the agile project manager have done to avoid this?", "opts": {"A": "Invited end customers to attend the stand ups", "B": "Organized design review sessions with the customer to obtain sign-off", "C": "Held regular meetings with the product owner and project team to elicit detailed business requirements", "D": "Conducted frequent review meetings with the customer to continually enhance delivery effectiveness"}, "a": "D", "th": "Team giao đúng kế hoạch sprint, velocity ổn định, nhưng cuối release khách không hài lòng về chất lượng.", "dung": "Họp review thường xuyên với khách để liên tục cải thiện → phát hiện sớm vấn đề chất lượng.", "sai": {"A": "Mời khách dự stand-up — không phù hợp.", "B": "Ký duyệt thiết kế — kiểu truyền thống.", "C": "Lấy yêu cầu chi tiết — kiểu waterfall."}, "meo": "Khách không hài lòng cuối release → thiếu review thường xuyên.", "note": ""}, {"n": 122, "stem": "A company president is concerned about the impact of a natural disaster on the company.\nHow should management identify areas to apply its resources and mitigate potential impacts?", "opts": {"A": "Establish and keep an active risk register that includes mitigation strategies and a cost-benefit analysis", "B": "Establish and keep an active risk register based on qualitative risk analysis and expected losses", "C": "Have each development team post the highest risk development items on the information radiator", "D": "Avoid risk by splitting development teams into two locations to ensure knowledge continuity"}, "a": "A", "th": "Chủ tịch lo ảnh hưởng của thiên tai. Quản lý xác định nơi cần đầu tư nguồn lực để giảm thiểu thế nào?", "dung": "Duy trì risk register gồm chiến lược giảm thiểu và phân tích chi phí–lợi ích → biết nên chi vào đâu.", "sai": {"B": "Chỉ phân tích định tính và tổn thất — thiếu cost-benefit để chọn nơi đầu tư.", "C": "Rủi ro phát triển trên radiator — không liên quan thiên tai.", "D": "Chia team 2 nơi — một chiến lược riêng lẻ, chưa phân tích."}, "meo": "\"Nơi đầu tư nguồn lực\" → cost-benefit analysis.", "note": ""}, {"n": 123, "stem": "An event management team is following an agile approach to prepare for an upcoming conference. The regional sales manager, from where the conference is to be held, contacts the team with a number of questions about the company's booth.\nWhat should the team do?", "opts": {"A": "Inform the sponsor about the regional sales manager's disruptiveness and ask that all questions be diverted to the weekly meetings", "B": "Stay focused on the current iteration and let the project manager deal with the regional sales manager's questions", "C": "Invite the regional sales manager to the next iteration review to share the progress", "D": "Create a risk on the risk register to account for some potentially new requirements from the regional sales manager"}, "a": "C", "th": "Team tổ chức sự kiện dùng agile; quản lý bán hàng khu vực hỏi nhiều về gian hàng.", "dung": "Mời người này dự iteration review tiếp theo để xem tiến độ — họ là stakeholder, chỉ hỏi tình trạng, không yêu cầu tính năng mới.", "sai": {"A": "Coi họ là phiền phức — sai thái độ với stakeholder.", "B": "Đẩy cho PM — né tránh.", "D": "Ghi rủi ro — họ chưa yêu cầu gì mới."}, "meo": "Stakeholder hỏi tiến độ → mời dự review.", "note": ""}, {"n": 124, "stem": "What should a team consider when calculating the effort needed to complete a product backlog?", "opts": {"A": "The increase in velocity and cost", "B": "A buffer in the sprint to mitigate unexpected risks", "C": "Assigning extra points to each task to allow time for changes", "D": "Stories describing infrastructure tasks and analysis tasks"}, "a": "B", "th": "Khi tính công sức hoàn thành product backlog, cần cân nhắc gì?", "dung": "Đưa vào một khoảng đệm (buffer) để giảm thiểu rủi ro bất ngờ → dự báo thực tế hơn.", "sai": {"A": "Tăng velocity và chi phí — không liên quan.", "C": "Cộng thêm point cho mỗi task — \"độn\" ước lượng, không minh bạch.", "D": "Story hạ tầng và phân tích — có thể cần nhưng không phải đáp án của bộ đề."}, "meo": "Dự báo backlog → thêm buffer cho rủi ro.", "note": "Một số nguồn chọn D. Đáp án của file là B."}, {"n": 125, "stem": "Two teams have received project requirements and completed estimates. Team A estimates 420 story points for scope and 30 story points for velocity per sprint.\nTeam B estimates 280 story points for scope and 20 story points for velocity per sprint. Both teams have same number of team members and have assumed a sprint duration of 2 weeks.\nWhat can an agile practitioner conclude about team A and team B's estimate?", "opts": {"A": "Team B has underestimated scope compared to team A", "B": "Team A is more confident in delivering velocity than team B", "C": "Both teams need to indicate their proposed technology before the estimates can be analyzed", "D": "Both teams have estimated the project to be of same size"}, "a": "D", "th": "Team A: 420 điểm, velocity 30/sprint. Team B: 280 điểm, velocity 20/sprint. Cùng số người, sprint 2 tuần.", "dung": "420/30 = 14 sprint; 280/20 = 14 sprint → hai team ước lượng dự án có cùng kích thước. Story point là tương đối riêng từng team, không so trực tiếp.", "sai": {"A": "Không thể so point giữa 2 team.", "B": "Velocity cao hơn không có nghĩa là tự tin hơn.", "C": "Không cần công nghệ để kết luận."}, "meo": "So sánh team → tính số sprint (scope ÷ velocity), không so point.", "note": ""}, {"n": 126, "stem": "Throughout the project, an agile practitioner notices that one team member is becoming an emergent leader.\nWhat should an agile practitioner do?", "opts": {"A": "Present opportunities in order to be supportive and grow that team member's talents", "B": "Encourage the team member to fit in more with the established team norms", "C": "Bring this to management's attention so they don't disrupt the team", "D": "Ask team member to respect defined roles on the project to avoid confusion with the team"}, "a": "A", "th": "Một thành viên đang nổi lên như một người dẫn dắt (emergent leader).", "dung": "Tạo cơ hội hỗ trợ và phát triển tài năng người đó — agile khuyến khích lãnh đạo phân tán.", "sai": {"B": "Bắt hòa nhập chuẩn chung — kìm hãm.", "C": "Báo quản lý — vô lý.", "D": "Yêu cầu tôn trọng vai trò — kìm hãm."}, "meo": "Emergent leader → hỗ trợ phát triển.", "note": ""}, {"n": 127, "stem": "A product's scope and acceptance criteria have been detailed, and the product is planned for release at the end of the next quarter.\nWhat should the project team do next?", "opts": {"A": "Estimate the project team's capacity", "B": "Determine how much work can be delivered", "C": "Calculate how much work will fit into the next iteration", "D": "Estimate items in the product backlog"}, "a": "D", "th": "Phạm vi và acceptance criteria đã chi tiết; dự định phát hành cuối quý sau. Bước tiếp theo?", "dung": "Các bước lập kế hoạch release: (1) xác định điều kiện hài lòng → (2) ước lượng user story → (3) chọn độ dài iteration → (4) ước tính velocity → (5) ưu tiên → (6) chọn story và ngày. Đã có (1), nên tiếp theo là ước lượng các item trong backlog.", "sai": {"A": "Ước tính năng lực — sau bước ước lượng.", "B": "Xác định khối lượng giao được — cần ước lượng trước.", "C": "Tính cho iteration kế tiếp — chưa tới bước đó."}, "meo": "Release planning: Điều kiện → Ước lượng → Iteration → Velocity → Ưu tiên → Chọn.", "note": ""}, {"n": 128, "stem": "At the retrospective, the burndown chart shows that the project is slightly behind schedule. The project team identifies an inexperienced software engineer as the source of reduced velocity.\nHow should the project team address this issue?", "opts": {"A": "Suggest pair programming during the retrospective", "B": "Ask the product owner to re-prioritize the user stories at the next retrospective", "C": "Re-estimate the story points with team members at the next iteration planning meeting", "D": "Assign less complex user stories to the inexperienced software engineer at the next iteration planning meeting"}, "a": "A", "th": "Retro cho thấy hơi trễ; nguyên nhân là kỹ sư thiếu kinh nghiệm.", "dung": "Đề xuất pair programming → người thiếu kinh nghiệm học nhanh, chất lượng và velocity tăng.", "sai": {"B": "PO ưu tiên lại — không giải quyết gốc.", "C": "Ước lượng lại — không giúp người mới.", "D": "Giao việc dễ hơn — không giúp phát triển."}, "meo": "Người thiếu kinh nghiệm → pair programming.", "note": ""}, {"n": 129, "stem": "How should a project leader manage stakeholder expectations in an agile project?", "opts": {"A": "Establish a common vision and success criteria and involve all the stakeholders in the iteration reviews", "B": "Invite stakeholders for the iteration reviews but do not include new stakeholders which may limit project success", "C": "Involve all the stakeholders in iteration reviews but do not entertain all expectations of all stakeholders", "D": "Communicate issues to all stakeholders via email and only communicate risks to internal stakeholders"}, "a": "A", "th": "Quản lý kỳ vọng stakeholder trong dự án agile thế nào?", "dung": "Xây dựng vision chung, tiêu chí thành công và mời tất cả stakeholder tham gia iteration review → kỳ vọng thống nhất và cập nhật liên tục.", "sai": {"B": "Loại stakeholder mới — sai.", "C": "Không tiếp nhận kỳ vọng — tiêu cực.", "D": "Email và giấu rủi ro với bên ngoài — không minh bạch."}, "meo": "Kỳ vọng stakeholder → vision chung + review.", "note": ""}, {"n": 130, "stem": "A scrum master would like to provide information to key stakeholders on the daily resource and project activities.\nWhich tool should the Scrum master use to provide these updates?", "opts": {"A": "Shared vision statement and sprint goal", "B": "Release burnup chart", "C": "Velocity metrics", "D": "Iteration burndown chart"}, "a": "D", "th": "SM muốn cung cấp thông tin hoạt động hàng ngày cho stakeholder.", "dung": "Iteration burndown chart thể hiện tiến độ từng ngày trong iteration.", "sai": {"A": "Vision và sprint goal — không có số liệu hàng ngày.", "B": "Release burnup — mức release, không phải hàng ngày.", "C": "Velocity — mỗi iteration một số."}, "meo": "Hàng ngày → Iteration burndown; Release → burnup.", "note": ""}, {"n": 131, "stem": "After a successful product deployment, a key stakeholder informs an agile team member that an implemented feature is failing to deliver its expected business value. The team member replies that the requirement was provided by the customer, and that the scope was clearly met.\nIf the problem were an issue of requirement elicitation rather than delivery, what should have been done to avoid this situation?", "opts": {"A": "Stakeholders should have regularly been engaged to obtain feedback and reduce the functionality risk", "B": "The team should have used the lean principle of delay, so that actual facts could be considered rather than assumptions and predictions", "C": "Interdependent teams should have been engaged using a collaborative approach to identify and leverage the best support", "D": "An owner should have been identified to obtain timely stakeholder feedback"}, "a": "A", "th": "Tính năng giao đúng yêu cầu khách nhưng không mang lại giá trị kinh doanh; nếu là vấn đề thu thập yêu cầu thì lẽ ra cần làm gì?", "dung": "Thường xuyên engage stakeholder để lấy phản hồi → giảm rủi ro tính năng sai.", "sai": {"B": "Trì hoãn quyết định — không phải vấn đề ở đây.", "C": "Team phụ thuộc — không liên quan.", "D": "Có người phụ trách — chưa đủ, cần phản hồi thường xuyên."}, "meo": "Sai giá trị → engage stakeholder thường xuyên.", "note": ""}, {"n": 132, "stem": "During a project's last few sprints, an agile practitioner notices an increase in defects. A rootcause analysis indicates that a poor understanding of the requirements was caused by the inability of the product owner to communicate clearly.\nWhat should the agile practitioner do?", "opts": {"A": "Inform the product owner's manager so that corrective action may be taken", "B": "Communicate this to the product owner, and offer to help facilitate discussion with the team", "C": "Encourage a team member to raise this during the retrospective to ensure that the product owner is aware", "D": "Escalate this issue to the sponsor so that corrective action may be taken"}, "a": "B", "th": "Lỗi tăng do PO giao tiếp không rõ ràng.", "dung": "Nói thẳng với PO và đề nghị hỗ trợ điều phối thảo luận với team → giải quyết trực tiếp, mang tính hỗ trợ.", "sai": {"A": "Báo quản lý của PO — leo thang không cần thiết.", "C": "Để người khác nêu ở retro — gián tiếp.", "D": "Leo thang lên sponsor — quá sớm."}, "meo": "Vấn đề với một người → nói trực tiếp + hỗ trợ.", "note": ""}, {"n": 133, "stem": "An agile team lead is assigned to a project that must ensure data security.\nWhat should the team lead do to guarantee that security, as a non-functional requirement, is managed throught the project?", "opts": {"A": "Include security concerns on the agenda for every meeting", "B": "Request that a security expert be added to the team", "C": "Add security as a non-functional requirement to the risk register, and review regularly", "D": "Ensure that planning and prioritizing includes consideration of security requirements"}, "a": "D", "th": "Dự án phải đảm bảo bảo mật dữ liệu (NFR). Làm sao quản lý xuyên suốt?", "dung": "Đảm bảo việc lập kế hoạch và ưu tiên luôn xem xét yêu cầu bảo mật → bảo mật được tích hợp vào backlog.", "sai": {"A": "Đưa vào mọi cuộc họp — lãng phí.", "B": "Thêm chuyên gia — chưa đảm bảo được quản lý xuyên suốt.", "C": "Risk register — NFR không phải rủi ro."}, "meo": "NFR quan trọng → tích hợp vào planning/prioritization.", "note": ""}, {"n": 135, "stem": "A project sponsor is upset that an enhancement will be unavailable until next year.\nWhat should the product owner do?", "opts": {"A": "Accept responsibility for the product's delay", "B": "Ensure that the project sponsor's priorities are in the product backlog", "C": "Negotiate with the project sponsor for increased funding", "D": "Empower the project sponsor to manage the product backlog"}, "a": "B", "th": "Sponsor buồn vì một cải tiến phải đến năm sau mới có.", "dung": "Đảm bảo các ưu tiên của sponsor được phản ánh trong product backlog.", "sai": {"A": "Nhận lỗi — không giải quyết.", "C": "Đàm phán thêm tiền — không chắc giải quyết được.", "D": "Để sponsor quản lý backlog — sai vai trò."}, "meo": "Stakeholder không vui với ưu tiên → đưa ưu tiên vào backlog.", "note": ""}, {"n": 136, "stem": "An agile practitioner notices that team members are disengaged. As a result, the team's velocity has decreased.\nWhat should the agile practitioner do to get the team back on track?", "opts": {"A": "Escalate the issue to the project sponsor", "B": "Remove stories to increase velocity", "C": "Hold a standup to address the issue", "D": "Facilitate a team retrospective"}, "a": "D", "th": "Team mất hứng thú (disengaged), velocity giảm.", "dung": "Tổ chức retrospective để team cùng nhìn lại nguyên nhân và tìm cách cải thiện.", "sai": {"A": "Leo thang — không cần.", "B": "Bỏ bớt story để tăng velocity — vô nghĩa.", "C": "Stand-up không phải nơi giải quyết."}, "meo": "Vấn đề tinh thần/hiệu suất team → retrospective.", "note": ""}, {"n": 137, "stem": "During sprint retrospectives, some team members are very vocal and tend to dominate the conversation, while others are more reserved and less likely to participate.\nWhat should the scrum master do?", "opts": {"A": "Encourage all team members to participate, and have them type their retrospective feedback into the agile lifecycle management tool", "B": "Ask more specific questions during the retrospectives", "C": "Sue retrospective techniques, such as silent writing, clustering, and dot voting to field feedback prior to discussion by the team", "D": "Ask team members to email feedback that can be summarized in a spreadsheet for the team"}, "a": "C", "th": "Trong retro, một số người lấn át, một số trầm lặng không tham gia.", "dung": "Dùng kỹ thuật silent writing, clustering, dot voting → ai cũng đóng góp được trước khi thảo luận.", "sai": {"A": "Gõ vào tool — không tạo sự cân bằng tốt.", "B": "Hỏi cụ thể hơn — vẫn người nói nhiều sẽ trả lời.", "D": "Email tổng hợp — mất tương tác."}, "meo": "Có người lấn át → silent writing + dot voting.", "note": ""}, {"n": 138, "stem": "An agile team provides feedback that user stories include insufficient details to understand the requirements.\nWhat should the agile practitioner do?", "opts": {"A": "Coach the product owner to update only the acceptance criteria", "B": "Instruct the agile team to fix the user stories during the next retrospective", "C": "Facilitate a user story workshop with the agile team", "D": "Inform the product owner's manager that the work items provide insufficient details"}, "a": "C", "th": "Team cho rằng user story thiếu chi tiết để hiểu yêu cầu.", "dung": "Tổ chức user story workshop với team (và PO) để cùng viết, làm rõ story.", "sai": {"A": "Chỉ cập nhật acceptance criteria — chưa đủ.", "B": "Retro không phải nơi sửa story.", "D": "Báo quản lý của PO — đối đầu."}, "meo": "Story thiếu chi tiết → user story workshop.", "note": ""}, {"n": 139, "stem": "Following an upgrade, a software support team is overwhelmed by the number of tickets being submitted by end users. The team's manager is pushing the team to `work smart` by focusing on activities that deliver the most value in the least amount of time.\nWhat should the team do?", "opts": {"A": "Work longer hours to complete more of the support backlog", "B": "Work support tickets in the order in which they were received", "C": "Place tickets on hold until the team completes an analysis of the backlog to identify and resolve systematic issues", "D": "Add members to the support team"}, "a": "C", "th": "Sau nâng cấp, team hỗ trợ ngập trong ticket; quản lý yêu cầu \"làm việc thông minh\".", "dung": "Tạm giữ ticket, phân tích backlog để tìm và sửa vấn đề hệ thống (gốc rễ) → giải quyết hàng loạt ticket cùng lúc.", "sai": {"A": "Làm thêm giờ — không thông minh.", "B": "Làm theo thứ tự đến — không theo giá trị.", "D": "Thêm người — không giải quyết gốc."}, "meo": "Nhiều lỗi giống nhau → tìm nguyên nhân hệ thống.", "note": ""}, {"n": 141, "stem": "During a Kanban team's daily stand-up, an agile coach observes that the team seems disinterested in the work status. While it appears that there are no issues with flow, there is a marked lack of attention to ream effort. When the agile coach queries the team for reasons, members explain that work continues to be scheduled with no end in sight.\nWhat should the agile coach do?", "opts": {"A": "Work with the team to determine points at which to celebrate its work", "B": "Provide the team with a break by scheduling a team event", "C": "Have the team increase work in progress (WIP) levels to more quickly complete the flow", "D": "Rejuvenate the team by temporarily reducing WIP levels"}, "a": "A", "th": "Team Kanban có vẻ không quan tâm tới trạng thái công việc vì việc cứ đến liên tục, \"không thấy điểm dừng\".", "dung": "Cùng team xác định các mốc để ăn mừng thành quả → tạo cảm giác hoàn thành, tăng động lực.", "sai": {"B": "Tổ chức sự kiện nghỉ ngơi — chỉ tạm thời.", "C": "Tăng WIP — làm tình hình tệ hơn.", "D": "Giảm WIP tạm thời — không giải quyết cảm giác \"không có điểm dừng\"."}, "meo": "Không thấy điểm kết thúc → tạo mốc ăn mừng.", "note": ""}, {"n": 142, "stem": "At the end of a product development phase, an agile project team confirms that all tests have passed. The product is released, but the customer complains that it is deficient.\nWhat should the project team have done prior to product release?", "opts": {"A": "Requested approval from the project sponsor", "B": "Undertaken a review of all requirements", "C": "Conducted an end-of-phase demonstration", "D": "Performed a retrospective to validate project deliverables"}, "a": "C", "th": "Mọi test đã pass, sản phẩm phát hành nhưng khách phàn nàn sản phẩm thiếu sót.", "dung": "Demo cuối giai đoạn cho khách hàng trước khi phát hành → khách xác nhận sản phẩm đúng nhu cầu. Test pass chỉ chứng minh \"làm đúng spec\", demo mới chứng minh \"làm đúng thứ khách cần\".", "sai": {"A": "Phê duyệt của sponsor — không phải khách hàng.", "B": "Review tất cả yêu cầu — vẫn là xem trên giấy; nhiều nguồn cũng chấp nhận B.", "D": "Retro là cải tiến quy trình, không xác nhận sản phẩm."}, "meo": "Test pass mà khách vẫn không hài lòng → thiếu DEMO với khách.", "note": "File ghi \"B or C\". Ở đây chọn C vì demo cho khách là cách agile xác nhận sản phẩm."}, {"n": 144, "stem": "An agile team has been in place for five years and the customer is satisfied with the team's performance and deliverables. Now that the product is built and delivered, the customer is considering the future role of the Scrum Master.\nWhat should the customer do?", "opts": {"A": "Expand the Scrum Master's role to other projects, while allowing them to support the current project", "B": "Release the Scrum Master, since the team is adequately skilled with agile practices", "C": "Expand the product owner's role to serve as the Scrum Master, while providing additional product knowledge", "D": "Increase the functional manager's role to act as the Scrum Master, while providing additional information about functional areas"}, "a": "A", "th": "Team 5 năm, khách hài lòng. Sản phẩm đã xong, khách cân nhắc vai trò tương lai của SM.", "dung": "Mở rộng vai trò SM sang dự án khác, đồng thời vẫn hỗ trợ dự án hiện tại → tận dụng kinh nghiệm, team vẫn có hỗ trợ.", "sai": {"B": "Cho SM nghỉ — team vẫn có thể cần hỗ trợ.", "C": "PO kiêm SM — xung đột vai trò.", "D": "Quản lý chức năng làm SM — xung đột vai trò."}, "meo": "SM giỏi, team trưởng thành → mở rộng SM sang dự án khác.", "note": ""}, {"n": 145, "stem": "A product owner adds a 21-point, high-priority story to a sprint backlog. The team is concerned that it cannot be completed during the current sprint.\nWhat should the team do?", "opts": {"A": "Advise the product owner that the story will have to wait until the next sprint", "B": "Work extra hours to complete the story and satisfy the customer's requirements", "C": "Break down the story into smaller increments and negotiate other stories on the sprint backlog", "D": "Increase the length of the sprint to accommodate the story"}, "a": "C", "th": "PO thêm story 21 điểm, ưu tiên cao vào sprint backlog; team lo không hoàn thành trong sprint.", "dung": "Chia story thành phần nhỏ hơn và thương lượng với PO về các story khác trong sprint backlog → vẫn giao giá trị ưu tiên cao.", "sai": {"A": "Từ chối và đợi — không linh hoạt.", "B": "Làm thêm giờ — không bền vững.", "D": "Kéo dài sprint — time box cố định."}, "meo": "Story quá lớn → chia nhỏ + thương lượng scope.", "note": ""}, {"n": 146, "stem": "A senior team member feels underutilized.\nWhat should the agile practitioner do?", "opts": {"A": "Transfer the senior member to another team that will more fully utilize their skill set", "B": "Conduct a performance evaluation to determine whether or not this member is a team player", "C": "Encourage the project team to involve the senior member in more project activities", "D": "Ask the functional manager to determine the best course of action"}, "a": "C", "th": "Một thành viên senior cảm thấy không được tận dụng.", "dung": "Khuyến khích team đưa người đó vào nhiều hoạt động hơn → team tự điều chỉnh.", "sai": {"A": "Chuyển team — mất nhân lực tốt.", "B": "Đánh giá hiệu suất — tiêu cực.", "D": "Đẩy cho quản lý chức năng — không cần."}, "meo": "Người bị dưới mức sử dụng → team tự lôi kéo vào.", "note": ""}, {"n": 147, "stem": "A product that recently went to market is receiving a great deal of attention from upper management who expresses interest by directly emailing and calling the developer team. The team expresses frustration during a standup.\nWhat should the Scrum Master do?", "opts": {"A": "Ask the product owner how upper management's comments can be redirected", "B": "Direct the developer team to ignore the phone calls and emails", "C": "Ask the product owner to enter the requests into the product backlog as high priority", "D": "Personally respond to upper management's phone calls and emails"}, "a": "A", "th": "Lãnh đạo cấp cao trực tiếp email, gọi điện cho dev; team bực bội.", "dung": "Hỏi PO cách chuyển hướng các ý kiến của lãnh đạo → PO là đầu mối nhận yêu cầu, bảo vệ team khỏi gián đoạn.", "sai": {"B": "Lờ đi lãnh đạo — không phù hợp.", "C": "Đưa vào backlog với ưu tiên cao ngay — chưa đánh giá.", "D": "SM tự trả lời — bỏ qua PO."}, "meo": "Yêu cầu từ ngoài trực tiếp tới team → chuyển hướng qua PO.", "note": ""}, {"n": 148, "stem": "What estimation technique is an agile team using when collectively estimating the relative size of its stories using story points?", "opts": {"A": "Parametric", "B": "One-to-one comparison", "C": "Affinity", "D": "Planning poker"}, "a": "D", "th": "Team cùng ước lượng kích thước tương đối của story bằng story point.", "dung": "Planning poker: mỗi người chọn lá bài, cùng lật, thảo luận khác biệt → đồng thuận.", "sai": {"A": "Parametric — dùng mô hình thống kê.", "B": "So sánh 1-1 — không phải tên kỹ thuật chuẩn.", "C": "Affinity estimating — nhóm nhanh nhiều story, nhưng planning poker là đáp án tiêu chuẩn cho \"collectively estimating với story points\"."}, "meo": "Cùng ước lượng story point → Planning poker.", "note": ""}, {"n": 149, "stem": "The product owner wants to build security firewalls into the product.\nHow can the team members support this?", "opts": {"A": "Add new security features to the backlog and prioritize", "B": "Execute a spike to research security features for the project", "C": "Ask questions to determine where and how the product owner wants to use product", "D": "Ask questions to determine if the product owner can define the desired level of security"}, "a": "A", "th": "PO muốn xây dựng tường lửa bảo mật vào sản phẩm.", "dung": "Thêm tính năng bảo mật mới vào backlog và ưu tiên → quy trình chuẩn với mọi yêu cầu mới.", "sai": {"B": "Spike — chỉ cần nếu chưa rõ cách làm.", "C": "Hỏi thêm — có thể hữu ích nhưng không phải bước chính.", "D": "Hỏi thêm — có thể hữu ích nhưng không phải bước chính."}, "meo": "Yêu cầu mới → backlog + ưu tiên.", "note": ""}, {"n": 150, "stem": "A key stakeholder cannot attend the project vision statement development workshop. The stakeholder has emailed their requirements to the agile team lead, and believes that the vision statement is not critical.\nHow should the agile team lead respond?", "opts": {"A": "Emphasize to the stakeholder that a common, detailed vision will better ensure team understanding of the project", "B": "Personally meet with the stakeholder to understand their requirements, and then share the vision with the team", "C": "Work with the team to create a vision from the stakeholder's supplied requirements", "D": "Explain to the team that creating a vision is not critical in agile projects, as requirements may change over time"}, "a": "A", "th": "Stakeholder chính không dự được workshop viết vision, đã gửi yêu cầu qua email và cho rằng vision không quan trọng.", "dung": "Nhấn mạnh với stakeholder rằng vision chung giúp team hiểu dự án → thuyết phục họ tham gia.", "sai": {"B": "Gặp riêng rồi chia sẻ — vision không được xây dựng chung.", "C": "Team tự tạo vision từ email — thiếu stakeholder.", "D": "\"Vision không quan trọng\" — sai."}, "meo": "Vision chung rất quan trọng → giải thích và lôi kéo stakeholder.", "note": ""}, {"n": 152, "stem": "A project manager is concerned that the team has misaligned expectations with some stakeholders, and that user stories were written only for generic user's perspective. This may lead the team to miss stories for non-generic users.\nWhat agile tools can help the team address these issues?", "opts": {"A": "Information radiators and wireframes", "B": "Information radiators and story maps", "C": "Process flows and personas", "D": "Personas and extreme characters"}, "a": "D", "th": "Kỳ vọng lệch với stakeholder; story chỉ viết cho người dùng chung chung, có thể bỏ sót người dùng đặc biệt.", "dung": "Personas (hồ sơ người dùng điển hình) và extreme characters (nhân vật cực đoan) giúp phát hiện nhu cầu của các nhóm người dùng khác nhau.", "sai": {"A": "Information radiator, wireframe, story map — không giúp đa dạng hóa góc nhìn người dùng.", "B": "Information radiator, wireframe, story map — không giúp đa dạng hóa góc nhìn người dùng.", "C": "Process flow — không về người dùng."}, "meo": "Thiếu góc nhìn người dùng → Personas + Extreme characters.", "note": ""}, {"n": 153, "stem": "Based on the chart, what is the current status of the iteration when comparing story points planned versus completed?", "opts": {"A": "The iteration is in jeopardy", "B": "The team has removed scope", "C": "The iteration is ahead of schedule", "D": "The team's velocity is constant"}, "a": "A", "th": "Dựa vào biểu đồ (file không có hình), so sánh point kế hoạch và hoàn thành: iteration đang thế nào?", "dung": "Trong đề gốc, point hoàn thành thấp hơn nhiều so với kế hoạch → iteration đang gặp nguy (in jeopardy).", "sai": {"B": "Không có dấu hiệu bỏ scope.", "C": "Hoàn thành ít hơn — không thể vượt tiến độ.", "D": "Biểu đồ không cho thấy velocity ổn định."}, "meo": "Completed << Planned → iteration in jeopardy.", "note": "Câu này đi kèm biểu đồ trong đề gốc, file Excel không có hình."}, {"n": 154, "stem": "The amount of information captured in the project's defects is varying within the development team. Team members are becoming frustrated with the defect quality inconsistencies and the frequent clarification required.\nWhat should be done to address the issue?", "opts": {"A": "Stop the current iteration to discuss defect quality issues and explore solutions", "B": "Discuss and explore solutions in the next planning meeting and take corrective actions as required", "C": "Generate insights at the next retrospective and adjust processes as decided by the team", "D": "Assign corrective actions to the backlog for the team to identify the mandatory defect information"}, "a": "C", "th": "Thông tin trong các defect không đồng đều; team bực vì phải hỏi lại liên tục.", "dung": "Tìm hiểu ở retrospective tiếp theo và điều chỉnh quy trình theo quyết định của team.", "sai": {"A": "Dừng iteration — quá cực đoan.", "B": "Planning meeting — không phải nơi cải tiến quy trình.", "D": "Giao action vào backlog — chưa bàn với team."}, "meo": "Cải tiến cách làm việc → retrospective.", "note": ""}, {"n": 155, "stem": "An agile team delivered a feature in the last iteration. The product owner, who missed the planning and review meetings, was dissatisfied with feature. The team conducted a retrospective and reviewed the user stories related it.\nWhat should the agile team do next?", "opts": {"A": "Ensure that the product owner reviews the acceptance criteria for delivered user stories", "B": "Augment the quality assurance and continuous integration processes for delivery", "C": "Approach the relevant developers and testers regarding quality issues, in upcoming iterations", "D": "Ask the product owner to define the entire scope of delivery two to three iterations in advance"}, "a": "A", "th": "PO vắng planning và review, không hài lòng với tính năng đã giao. Team đã làm retro, xem lại story.", "dung": "Đảm bảo PO xem lại acceptance criteria của các story đã giao → hiểu chung \"thế nào là đạt\".", "sai": {"B": "Tăng QA, CI — vấn đề không phải lỗi kỹ thuật.", "C": "Tìm dev/tester — không phải vấn đề chất lượng.", "D": "Bắt PO định nghĩa toàn bộ scope trước 2–3 iteration — kiểu waterfall."}, "meo": "PO không hài lòng → cùng xem lại acceptance criteria.", "note": ""}, {"n": 157, "stem": "A development team, new to scrum, questions the need to collect metrics on team performance. While team members understand velocity and burn down, they feel that once velocity becomes settled it is needless to keep track.\nWhat should the agile coach tell the team?", "opts": {"A": "Continuing to track velocity allows functional managers to assess whether or not the team is performing at the desired rate", "B": "The trends will show how the team performs against other scrum teams in the organization", "C": "Tracking velocity will provide a baseline for the team to see how their continuous improvement efforts are working", "D": "Tracking velocity will document and communicate team health to the stakeholders"}, "a": "C", "th": "Team mới nghi ngờ việc tiếp tục đo velocity khi đã ổn định.", "dung": "Velocity là baseline để team thấy các nỗ lực cải tiến liên tục có hiệu quả hay không.", "sai": {"A": "Để quản lý đánh giá team — sai mục đích.", "B": "So sánh với team khác — sai, velocity không so giữa các team.", "D": "Báo sức khỏe team cho stakeholder — không phải mục đích chính."}, "meo": "Velocity dùng cho TEAM: dự báo và đo cải tiến.", "note": ""}, {"n": 158, "stem": "What can a team use to prioritize stories?", "opts": {"A": "MoSCoW method", "B": "Planning poker technique", "C": "Weighted average calculation", "D": "INVEST scale"}, "a": "A", "th": "Team có thể dùng gì để ưu tiên story?", "dung": "MoSCoW (Must, Should, Could, Won't) là kỹ thuật ưu tiên.", "sai": {"B": "Planning poker — ước lượng.", "C": "Trung bình có trọng số — không phải kỹ thuật chuẩn.", "D": "INVEST — tiêu chí story tốt."}, "meo": "Ưu tiên → MoSCoW.", "note": ""}, {"n": 159, "stem": "Business stakeholders of an agile project frequently skip the review meetings.\nWhat should the agile practitioner do?", "opts": {"A": "Ask the product owner to inform all stakeholders about the project's progress", "B": "Send meeting notes to all stakeholders after each review meeting", "C": "Include the results of the review meetings in the information radiators", "D": "Convince the stakeholders of the benefits of attending the review meetings"}, "a": "D", "th": "Stakeholder kinh doanh thường xuyên vắng mặt các buổi review.", "dung": "Thuyết phục họ về lợi ích của việc tham gia review → phản hồi trực tiếp là không thể thay thế.", "sai": {"A": "PO báo cáo thay — mất phản hồi trực tiếp.", "B": "Gửi biên bản — một chiều.", "C": "Đưa lên radiator — vẫn một chiều."}, "meo": "Stakeholder vắng review → thuyết phục họ tham gia.", "note": ""}, {"n": 160, "stem": "After three iterations, it is identified that a project's underlying security structure architecture is unstable. While there is a technical solution, all work to date is flawed. This will impact several future business service offerings.\nWhat should the product owner do to resolve this?", "opts": {"A": "Ask the development team to address the issue since it is in their domain", "B": "Review the project's risk matrix, and follow the steps outlined in the risk mitigation plan", "C": "Meet with the team and stakeholders to address rework and rewrite stories as needed", "D": "Cancel the current sprint, and meet with stakeholders to reassess the project's validity"}, "a": "C", "th": "Sau 3 iteration phát hiện kiến trúc bảo mật không ổn định; có giải pháp kỹ thuật nhưng mọi việc đã làm đều lỗi.", "dung": "PO họp với team và stakeholder để xử lý phần làm lại, viết lại story khi cần → minh bạch, cộng tác.", "sai": {"A": "Đẩy hết cho team — PO cần tham gia vì ảnh hưởng kinh doanh.", "B": "Làm theo kế hoạch rủi ro — có thể không có sẵn.", "D": "Hủy sprint và xem lại tính khả thi dự án — quá cực đoan khi đã có giải pháp."}, "meo": "Phát hiện lỗi lớn → cùng team + stakeholder lên kế hoạch làm lại.", "note": ""}, {"n": 161, "stem": "What is the first thing an agile development team should do when planning an iteration?", "opts": {"A": "Assign the tasks to one team member", "B": "Separate the stories into tasks", "C": "Estimate the stories' tasks", "D": "Help establish the next sprint's goal"}, "a": "D", "th": "Việc đầu tiên khi lập kế hoạch iteration là gì?", "dung": "Giúp xác định sprint goal → định hướng chọn story và task.", "sai": {"A": "Giao task cho một người — sai.", "B": "Chia task, ước lượng — sau khi có goal và chọn story.", "C": "Chia task, ước lượng — sau khi có goal và chọn story."}, "meo": "Planning bắt đầu từ Sprint Goal.", "note": ""}, {"n": 162, "stem": "During a retrospective, team members suggest process improvement ideas. The agile team lead knows that, while many of these ideas are different from standard practices, a few of them are good.\nWhat should the agile team lead do?", "opts": {"A": "Require the team to try only those ideas that will ensure success", "B": "Allow the team to try ideas, but remind them that results will be reviewed by high-ranking executives", "C": "Associate idea successes and failures with the team's incentive plan to ensure accountability", "D": "Encourage the team to try the ideas, even if failure may be the outcome"}, "a": "D", "th": "Retro có nhiều ý tưởng cải tiến khác với thông lệ; leader biết một vài ý tưởng hay.", "dung": "Khuyến khích team thử, kể cả khi có thể thất bại → học hỏi từ thử nghiệm (fail fast, learn fast).", "sai": {"A": "Chỉ thử ý tưởng chắc thành công — kìm hãm sáng tạo.", "B": "Nhắc lãnh đạo sẽ xem xét — gây sợ hãi.", "C": "Gắn với thưởng phạt — giảm an toàn tâm lý."}, "meo": "Ý tưởng mới → khuyến khích thử, chấp nhận thất bại.", "note": ""}, {"n": 163, "stem": "During the implementation of a story, a scrum team notifies the scrum master of a technical challenge that is causing a delay.\nWhat should the scrum master advise the team do?", "opts": {"A": "Implement the story since the team is running behind schedule", "B": "Create a spike to finalize the story's technical approach", "C": "Transfer the story to a scrum team experienced in solving similar problem", "D": "Ask the product owner to reduce the story's priority and wait until more technical details are available"}, "a": "B", "th": "Khi làm một story, team gặp thách thức kỹ thuật gây chậm.", "dung": "Tạo spike để làm rõ cách tiếp cận kỹ thuật trước khi làm tiếp.", "sai": {"A": "Cứ làm dù chưa rõ — rủi ro làm lại.", "C": "Chuyển sang team khác — mất ownership.", "D": "Hạ ưu tiên và chờ — thụ động."}, "meo": "Bất định kỹ thuật → Spike.", "note": ""}, {"n": 164, "stem": "The project team is ahead of schedule and beginning to gold-plate the feature included in the current sprint.\nWhat should the agile project manager do?", "opts": {"A": "Since the team has extra time, notify the product owner and secure approval for the extra work on this feature", "B": "Encourage the team to document the improvement and prioritize it for the upcoming iteration, instead of building it now", "C": "Instruct the Scrum Master to have the team use the extra time to complete the extra feature work in the current iteration", "D": "Notify the product owner and have the product owner verify the backlog priority, then encourage team to continue working on the backlog"}, "a": "D", "th": "Team đi trước tiến độ và bắt đầu \"mạ vàng\" (gold-plate) tính năng — thêm thứ không ai yêu cầu.", "dung": "Báo PO để PO kiểm tra ưu tiên backlog, rồi khuyến khích team làm tiếp việc trong backlog → tránh lãng phí.", "sai": {"A": "Xin phê duyệt để mạ vàng — vẫn là làm việc không ưu tiên.", "B": "Ghi lại và làm sau — vẫn khuyến khích mạ vàng.", "C": "Cho làm luôn — lãng phí."}, "meo": "Gold-plating = lãng phí → quay về backlog ưu tiên.", "note": ""}, {"n": 166, "stem": "The executive leadership wants to understand ways to better deliver on time and on budget.\nWhat can the project team do to assist in achieving the organizational goal?", "opts": {"A": "Maintain and review a lessons learned repository to improve delivery of future projects", "B": "Ask each team member to post corrective action to the backlog", "C": "Engage the project management office (PMO) to take responsibility identifying lessons learned on projects", "D": "Perform a root cause analysis to identify alternative approaches for performing the next project"}, "a": "A", "th": "Lãnh đạo muốn biết cách giao đúng hạn, đúng ngân sách hơn.", "dung": "Duy trì và xem lại kho lessons learned → các dự án sau tránh lặp lại sai lầm.", "sai": {"B": "Mỗi người đưa hành động khắc phục vào backlog — rời rạc.", "C": "Đẩy cho PMO — team mất trách nhiệm.", "D": "Root cause — hữu ích nhưng chỉ cho từng vấn đề."}, "meo": "Cải thiện cấp tổ chức → lessons learned repository.", "note": ""}, {"n": 167, "stem": "A new agile team ember notices that the team's current process involves excessive documentation.\nWhat should the new team member do?", "opts": {"A": "Teach the team the appropriate agile principle, obtain consensus, and drive adoption", "B": "Allow another team member to prepare those documents that do not appear to bring value", "C": "Notify the project manager about other documentation techniques, and identify which documents bring value and which do not", "D": "Follow the existing process to avoid conflicts"}, "a": "A", "th": "Thành viên mới thấy quy trình hiện tại có quá nhiều tài liệu.", "dung": "Chia sẻ nguyên tắc agile phù hợp (làm việc > tài liệu), đạt đồng thuận rồi thúc đẩy áp dụng → thay đổi qua đồng thuận.", "sai": {"B": "Đùn việc cho người khác — không giải quyết.", "C": "Báo PM — gián tiếp, không cần.", "D": "Theo quy trình cũ để tránh xung đột — thụ động."}, "meo": "Thấy lãng phí → chia sẻ nguyên tắc + đồng thuận.", "note": ""}, {"n": 168, "stem": "A team working with a new technology faces a significant amount of uncertainty about its ability to deliver stories due to technical issues.\nWhat should the team do?", "opts": {"A": "Capture risks and make them visible, and use a burndown chart to focus on reducing risks early in the project", "B": "Ask the scrum master to extend the sprint's duration to allow more time to work through technical issues", "C": "Place the impacted stories on the story board, and use daily stand ups to make the product owner aware of the technical issues", "D": "Seek guidance from the development manager"}, "a": "A", "th": "Team dùng công nghệ mới, rất bất định về khả năng giao story.", "dung": "Ghi nhận và hiển thị rủi ro, dùng risk burndown chart để tập trung giảm rủi ro sớm.", "sai": {"B": "Kéo dài sprint — sai.", "C": "Chỉ báo PO — chưa xử lý.", "D": "Hỏi quản lý — không tự tổ chức."}, "meo": "Bất định cao → hiển thị rủi ro + giảm sớm (risk burndown).", "note": ""}, {"n": 169, "stem": "Unable to meet a sprint's committed velocity, an agile team approaches the agile coach to define the next sprint's velocity.\nWhat should the agile coach advise?", "opts": {"A": "Split each story into multiple stories to meet the desired velocity", "B": "Set the velocity to the delivered story points of the last sprint", "C": "Use different estimation methods for stories and defects to meet the desired velocity", "D": "Re-estimate by assigning more story points to smaller stories to increase the velocity"}, "a": "B", "th": "Team không đạt velocity đã cam kết, hỏi coach velocity sprint sau nên là bao nhiêu.", "dung": "Dùng số point thực tế đã giao ở sprint trước (yesterday's weather) → thực tế nhất.", "sai": {"A": "Chia story, đổi cách ước lượng, tăng point — đều là \"làm đẹp số liệu\".", "C": "Chia story, đổi cách ước lượng, tăng point — đều là \"làm đẹp số liệu\".", "D": "Chia story, đổi cách ước lượng, tăng point — đều là \"làm đẹp số liệu\"."}, "meo": "Velocity sprint sau = velocity thực tế sprint trước.", "note": ""}, {"n": 170, "stem": "After seeing the planned features for an upcoming release, a customer notes that a vitally important and complex one is missing. The team estimates that this feature significantly exceeds its average velocity.\nHow can this issue be resolved?", "opts": {"A": "Break down the feature into smaller parts, and commit to complementing the minimum value product", "B": "Complete the iteration to which they have already committed, and include the feature in the next release", "C": "Change the planned features to include only the vitally important one", "D": "Extend the iteration to complete the feature"}, "a": "A", "th": "Khách phát hiện thiếu một tính năng rất quan trọng và phức tạp, vượt quá velocity trung bình.", "dung": "Chia nhỏ tính năng và cam kết hoàn thành phần giá trị tối thiểu (MVP).", "sai": {"B": "Đợi release sau — tính năng quá quan trọng.", "C": "Chỉ làm tính năng đó — bỏ hết kế hoạch.", "D": "Kéo dài iteration — sai time box."}, "meo": "Tính năng lớn + quan trọng → chia nhỏ, giao phần tối thiểu.", "note": ""}, {"n": 171, "stem": "During an iteration planning meeting, the team suggests changes to add product vale that will require extra work and impact the schedule.\nWhat should the agile project leader do?", "opts": {"A": "Re-estimate the project", "B": "Finish the product as it was initially planned", "C": "Try to include as many changes as possible", "D": "Ask the product owner for approval to proceed"}, "a": "D", "th": "Team đề xuất thay đổi tăng giá trị nhưng tốn thêm công và ảnh hưởng lịch.", "dung": "Hỏi PO phê duyệt — PO quyết định về giá trị và đánh đổi.", "sai": {"A": "Ước lượng lại toàn dự án — chưa cần.", "B": "Bỏ qua thay đổi — mất giá trị.", "C": "Làm nhiều nhất có thể — chưa có quyết định của PO."}, "meo": "Đánh đổi giá trị vs lịch → PO quyết.", "note": ""}, {"n": 173, "stem": "There is a database feature requiring three members of a seven person team. A meeting is scheduled at the beginning of the sprint to go over technical needs to complete the story.\nWho should the Scrum Master invite to the meeting?", "opts": {"A": "The core team and the customer", "B": "The product owner and key stakeholders", "C": "The customer and the sponsor", "D": "The core team and the product owner"}, "a": "D", "th": "Tính năng database cần 3/7 người. Họp đầu sprint về yêu cầu kỹ thuật. Mời ai?", "dung": "Core team (Development Team) và PO — những người cần hiểu và quyết định.", "sai": {"A": "Khách hàng, sponsor không cần trong họp kỹ thuật.", "C": "Khách hàng, sponsor không cần trong họp kỹ thuật.", "B": "Thiếu team."}, "meo": "Họp kỹ thuật đầu sprint → team + PO.", "note": ""}, {"n": 174, "stem": "As user stories are developed, what should be done to record and update acceptance criteria?", "opts": {"A": "Add more user stories", "B": "Use sprint retrospectives", "C": "Update current user stories", "D": "Update new tasks in the project plan"}, "a": "C", "th": "Khi phát triển user story, ghi và cập nhật acceptance criteria thế nào?", "dung": "Cập nhật trực tiếp trên user story hiện tại → acceptance criteria là một phần của story.", "sai": {"A": "Thêm story — không cần.", "B": "Retro — không phải nơi đó.", "D": "Kế hoạch dự án — kiểu truyền thống."}, "meo": "Acceptance criteria nằm trong user story.", "note": ""}, {"n": 175, "stem": "Midway through a two-week sprint, an agile team realizes that the features cannot be delivered within the sprint. The team determines that another week will be required to complete all committed features.\nWhat should the team do?", "opts": {"A": "Plan for overtime, and include the effort as part of the estimation", "B": "Increase team velocity to deliver more story points", "C": "Identify the reason for over-commitment to the sprint and create an action plan for the following sprint", "D": "Add resources to assist with sprint execution"}, "a": "C", "th": "Giữa sprint 2 tuần, team nhận ra không giao kịp, cần thêm 1 tuần.", "dung": "Xác định lý do cam kết quá mức và lập kế hoạch hành động cho sprint sau → học hỏi, cải tiến.", "sai": {"A": "Làm thêm giờ — không bền vững.", "B": "Tăng velocity — không thực tế.", "D": "Thêm người — không hiệu quả ngắn hạn."}, "meo": "Cam kết quá sức → tìm nguyên nhân, cải tiến sprint sau.", "note": ""}, {"n": 176, "stem": "On what should an agile team work to achieve predictable flow?", "opts": {"A": "Small user stories", "B": "Simple acceptance criteria", "C": "Lean features", "D": "Lean backlogs"}, "a": "A", "th": "Để có dòng chảy (flow) ổn định, dễ dự đoán, team nên làm việc với gì?", "dung": "User story nhỏ → đi qua hệ thống nhanh, đồng đều → flow dễ dự đoán.", "sai": {"B": "Acceptance criteria đơn giản — không quyết định flow.", "C": "\"Lean features/backlog\" — không phải yếu tố chính.", "D": "\"Lean features/backlog\" — không phải yếu tố chính."}, "meo": "Flow ổn định → story NHỎ.", "note": ""}, {"n": 177, "stem": "How can a scrum team obtain more feedback from a minimally responsive outside stakeholder?", "opts": {"A": "Keep sprints short", "B": "Invite the stakeholder to the daily stand ups", "C": "Ask the stakeholder for estimates for each user story", "D": "Schedule more demos during each sprint"}, "a": "D", "th": "Làm sao có thêm phản hồi từ stakeholder bên ngoài ít phản hồi?", "dung": "Tổ chức nhiều demo hơn trong mỗi sprint → nhiều cơ hội để họ phản hồi.", "sai": {"A": "Sprint ngắn — gián tiếp.", "B": "Mời dự stand-up — không phù hợp.", "C": "Nhờ họ ước lượng — không phải việc của họ."}, "meo": "Cần thêm feedback → thêm demo.", "note": ""}, {"n": 178, "stem": "A new CIO advocates an agile framework for new IT projects, but the team has reservations.\nHow should the CIO ensure that the team will be aligned with this?", "opts": {"A": "Obtain executive team buy-in by conducting a meeting to present the advantages of agile principles and processes", "B": "Issue a memo of understanding that agile principle should be implemented for all new projects", "C": "Introduce agile principles and processes, then make the change an experiment to obtain buy-in", "D": "Require all staff and management to attend agile training and adhere to its principles"}, "a": "C", "th": "CIO mới ủng hộ agile, team còn e dè. Làm sao team đồng thuận?", "dung": "Giới thiệu nguyên tắc agile, rồi biến việc thay đổi thành một thử nghiệm → team trải nghiệm thực tế, tự tin hơn.", "sai": {"A": "Thuyết phục ban điều hành — team mới là người e dè.", "B": "Ra văn bản bắt buộc — áp đặt.", "D": "Bắt đào tạo và tuân thủ — áp đặt."}, "meo": "Thay đổi bị phản đối → thử nghiệm để có buy-in.", "note": ""}, {"n": 179, "stem": "An agile team is unable to complete all its planned sprint user stories, which results in a decrease of its planned sprint velocity.\nWhat should the team do?", "opts": {"A": "Re-estimate the sprint's completed stories to increase and adjust the sprint's velocity", "B": "Increase the duration of the next sprint to accommodate the incomplete user stories and maintain velocity", "C": "Work with the product owner to create a spike with another agile team", "D": "Re-estimate the incomplete stories for the next sprint because its relative size has changed"}, "a": "D", "th": "Team không hoàn thành hết story, velocity giảm.", "dung": "Ước lượng lại story chưa xong cho sprint sau vì kích thước tương đối của chúng đã thay đổi (một phần đã làm).", "sai": {"A": "Ước lượng lại story đã xong để tăng velocity — gian lận số liệu.", "B": "Kéo dài sprint — sai time box.", "C": "Spike với team khác — không liên quan."}, "meo": "Story dở dang → re-estimate phần còn lại.", "note": ""}, {"n": 180, "stem": "An agile project leader is delivering a team kick-off session. The first exercise is a `Life Timeline` `\" a story-telling exercise where each team member tells their life story, explains how they experienced the highs and lows of their journey, and identifies their fears and hopes.\nWhat is the project leader trying to create?", "opts": {"A": "A safe space for team members to learn to trust one another, leading to collaborative relationships", "B": "A safe space to team members to learn to be vulnerable, leading to high performance relationships", "C": "A safe space for team members to learn to share, leading to collaborative relationship", "D": "A safe space for team members to learn about each other's weaknesses and strengths"}, "a": "A", "th": "Kick-off: bài tập \"Life Timeline\" — mỗi người kể câu chuyện đời, thăng trầm, nỗi sợ và hy vọng.", "dung": "Tạo không gian an toàn để mọi người học cách tin tưởng nhau → dẫn đến quan hệ cộng tác.", "sai": {"B": "\"Học cách dễ tổn thương\" — không phải mục tiêu chính.", "C": "Chia sẻ — đúng một phần nhưng thiếu yếu tố tin tưởng.", "D": "Biết điểm mạnh yếu — không phải mục đích."}, "meo": "Kể chuyện cá nhân ở kick-off → xây dựng TRUST.", "note": ""}, {"n": 181, "stem": "An agile team's client has been asked to expedite the delivery of the next release. By delivering one month early, the company can generate US$40,000 more than expected for the quarter.\nWhat should the agile team do?", "opts": {"A": "Adhere to the new deadline and immediately advise the client that the schedule has been expedited", "B": "Advise the client that it is best to continue as planned rather than introduce unforeseen risks by expecting the schedule", "C": "Submit a change request to the client with a 50% increase in charges due to the new potential profit", "D": "Request additional resources to meet the expedited deadline and obtain training for the new resources"}, "a": "B", "th": "Khách được yêu cầu giao sớm release tới; giao sớm 1 tháng sẽ thu thêm 40.000 USD.", "dung": "Khuyên khách tiếp tục theo kế hoạch thay vì tạo rủi ro không lường trước khi ép lịch → làm việc với nhịp bền vững.", "sai": {"A": "Đồng ý ngay — chưa đánh giá rủi ro.", "C": "Tăng 50% chi phí — không chuyên nghiệp.", "D": "Thêm người — cần đào tạo, không hiệu quả."}, "meo": "Ép lịch → nêu rủi ro, giữ nhịp bền vững.", "note": ""}, {"n": 182, "stem": "During an iteration, an agile team discovers infrastructure requirements that were not initially considered.\nWhat should the team do to effectively manage this?", "opts": {"A": "Rework the iteration scope to accommodate these requirements", "B": "Add these requirements into the product backlog for future consideration", "C": "Raise the discovery of these requirements as an issue, and escalate to management", "D": "Immediately start working on these requirements"}, "a": "B", "th": "Trong iteration, team phát hiện yêu cầu hạ tầng chưa được tính.", "dung": "Đưa vào product backlog để xem xét sau → PO ưu tiên.", "sai": {"A": "Thay đổi scope iteration — phá cam kết.", "C": "Leo thang — không cần.", "D": "Làm ngay — chưa ưu tiên."}, "meo": "Phát hiện yêu cầu mới → backlog.", "note": ""}, {"n": 183, "stem": "A new project starts and team members are pooled together to execute it. The team works together and moves from the forming stage into the storming stage.\nHowever, potentially destructive conflicts are now arising.\nWhat should the agile coach do to develop members into a high-performance team?", "opts": {"A": "Teach the team how to work comfortably in chaos", "B": "Provide strong facilitation and conflict-resolution guidance", "C": "Allow the team to resolve issues on their own", "D": "Observe each team member and advise them on team relationships"}, "a": "B", "th": "Team chuyển từ giai đoạn forming sang storming (mô hình Tuckman), có xung đột mang tính phá hoại.", "dung": "Giai đoạn storming cần facilitation mạnh và hướng dẫn giải quyết xung đột → giúp team chuyển sang norming.", "sai": {"A": "Dạy làm việc trong hỗn loạn — sai.", "C": "Để team tự xử — xung đột phá hoại cần can thiệp.", "D": "Khuyên từng cá nhân — không giải quyết ở cấp team."}, "meo": "Tuckman — Forming: directing; Storming: coaching/facilitate xung đột; Norming: supporting; Performing: delegating.", "note": ""}, {"n": 184, "stem": "Based on the burndown chart, what is the iteration's status?", "opts": {"A": "It trended ahead of schedule and completed everything on time", "B": "It look more time than expected and had to be lengthened", "C": "It trended behind schedule and did not complete everything on time", "D": "It took less time than expected and had to be shortened"}, "a": "C", "th": "Dựa vào burndown chart (file không có hình), trạng thái iteration?", "dung": "Giống câu 66: đường thực tế nằm trên đường lý tưởng và không về 0 → trễ tiến độ, không hoàn thành hết.", "sai": {"A": "Đi trước tiến độ → đường thực tế dưới đường lý tưởng.", "B": "Iteration có time box cố định, không kéo dài/rút ngắn.", "D": "Iteration có time box cố định, không kéo dài/rút ngắn."}, "meo": "Burndown trên đường lý tưởng = chậm.", "note": "Câu này đi kèm biểu đồ trong đề gốc, file Excel không có hình."}]</script>
<script>
const Q = JSON.parse(document.getElementById('data').textContent);
const KEY='acp-quiz-v1';
let st={ans:{},order:Q.map((_,i)=>i),cur:0,filter:'all'};
try{const s=JSON.parse(localStorage.getItem(KEY)||'null'); if(s&&s.order&&s.order.length===Q.length) st=Object.assign(st,s);}catch(e){}
const save=()=>{try{localStorage.setItem(KEY,JSON.stringify(st))}catch(e){}};
const $=id=>document.getElementById(id);
const esc=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
$('total').textContent=Q.length;

function visible(){
  return st.order.filter(i=>{
    const a=st.ans[Q[i].n];
    if(st.filter==='todo') return !a;
    if(st.filter==='bad') return a && a!==Q[i].a;
    if(st.filter==='note') return !!Q[i].note;
    return true;
  });
}

function renderStats(){
  const vals=Object.entries(st.ans); let ok=0;
  vals.forEach(([n,a])=>{const q=Q.find(x=>x.n==n); if(q&&q.a===a) ok++;});
  $('sDone').textContent=vals.length; $('sOk').textContent=ok; $('sBad').textContent=vals.length-ok;
  $('sPct').textContent=vals.length?Math.round(ok*100/vals.length)+'%':'–';
  $('bar').style.width=(vals.length*100/Q.length)+'%';
}

function renderGrid(){
  const vis=visible(); const g=$('grid'); g.innerHTML='';
  if(!vis.length){g.innerHTML='<p class="empty">Không có câu nào trong mục này.</p>';return;}
  vis.forEach(i=>{
    const q=Q[i],a=st.ans[q.n];
    const b=document.createElement('button');
    b.className='cell'+(a?(a===q.a?' ok':' bad'):'')+(i===st.cur?' cur':'');
    b.textContent=q.n; b.title='Câu '+q.n; b.setAttribute('aria-label','Câu '+q.n);
    b.onclick=()=>{st.cur=i;save();render();window.scrollTo({top:0,behavior:'smooth'})};
    g.appendChild(b);
  });
}

function renderQ(){
  const vis=visible(); const card=$('qcard');
  if(!vis.length){card.innerHTML='<p class="empty">Không có câu nào trong mục lọc này. Chọn "Tất cả" để xem lại toàn bộ đề.</p>';return;}
  if(!vis.includes(st.cur)) st.cur=vis[0];
  const q=Q[st.cur], pos=vis.indexOf(st.cur), picked=st.ans[q.n];
  let h=`<div class="qmeta"><span class="qno">Câu ${q.n}</span><span class="pos">${pos+1} / ${vis.length}</span></div>
  <p class="stem">${esc(q.stem)}</p><div class="opts" role="group" aria-label="Các đáp án">`;
  for(const k of ['A','B','C','D']){
    let cls='opt';
    if(picked){ if(k===q.a) cls+=' correct'; else if(k===picked) cls+=' wrong'; else cls+=' dim'; }
    h+=`<button class="${cls}" data-k="${k}" ${picked?'disabled':''}><span class="bub">${k}</span><span>${esc(q.opts[k])}</span></button>`;
  }
  h+='</div>';
  if(picked){
    const right=picked===q.a;
    h+=`<div class="verdict ${right?'ok':'bad'}">${right?'Chính xác! Đáp án đúng là '+q.a+'.':'Chưa đúng. Bạn chọn '+picked+', đáp án đúng là '+q.a+'.'}</div>
    <div class="exp">
      <div><h3>Tình huống</h3><p>${esc(q.th)}</p></div>
      <div><h3>Vì sao chọn ${q.a}</h3><p>${esc(q.dung)}</p></div>
      <div><h3>Vì sao các đáp án khác chưa đúng</h3><ul class="wrongs">${
        ['A','B','C','D'].filter(k=>k!==q.a).map(k=>`<li><span class="l">${k}</span><span>${esc(q.sai[k]||'')}</span></li>`).join('')}</ul></div>
      <div class="tip"><h3>Mẹo nhớ</h3><p>${esc(q.meo)}</p></div>
      ${q.note?`<div class="note"><h3>Lưu ý</h3><p>${esc(q.note)}</p></div>`:''}
    </div>`;
  }
  h+=`<div class="nav"><button class="btn" id="prev" ${pos===0?'disabled':''}>← Câu trước</button>
  <button class="btn primary" id="next" ${pos===vis.length-1?'disabled':''}>Câu tiếp →</button></div>
  <p class="keys">Phím tắt: <kbd>A</kbd>–<kbd>D</kbd> hoặc <kbd>1</kbd>–<kbd>4</kbd> để chọn, <kbd>←</kbd> <kbd>→</kbd> để chuyển câu.</p>`;
  card.innerHTML=h;
  card.querySelectorAll('.opt').forEach(b=>b.onclick=()=>choose(b.dataset.k));
  $('prev').onclick=()=>go(-1); $('next').onclick=()=>go(1);
}

function choose(k){const q=Q[st.cur]; if(st.ans[q.n]) return; st.ans[q.n]=k; save(); render();}
function go(d){const vis=visible(),p=vis.indexOf(st.cur),n=p+d; if(n<0||n>=vis.length) return; st.cur=vis[n]; save(); render(); window.scrollTo({top:0,behavior:'smooth'});}
function render(){renderQ();renderGrid();renderStats();
  document.querySelectorAll('.chip').forEach(c=>c.setAttribute('aria-pressed',c.dataset.f===st.filter));}

$('filters').onclick=e=>{const f=e.target.dataset&&e.target.dataset.f; if(!f) return; st.filter=f; const v=visible(); if(v.length&&!v.includes(st.cur)) st.cur=v[0]; save(); render();};
$('shuffle').onclick=()=>{const o=Q.map((_,i)=>i); for(let i=o.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[o[i],o[j]]=[o[j],o[i]];} st.order=o; st.cur=visible()[0]??0; save(); render();};
$('order').onclick=()=>{st.order=Q.map((_,i)=>i); st.cur=visible()[0]??0; save(); render();};
$('reset').onclick=()=>{$('confirmBox').hidden=false;};
$('no').onclick=()=>{$('confirmBox').hidden=true;};
$('yes').onclick=()=>{st.ans={}; st.filter='all'; st.cur=st.order[0]; $('confirmBox').hidden=true; save(); render();};
document.addEventListener('keydown',e=>{
  if(e.metaKey||e.ctrlKey||e.altKey) return;
  const m={a:'A',b:'B',c:'C',d:'D','1':'A','2':'B','3':'C','4':'D'}[e.key.toLowerCase()];
  if(m && visible().length) choose(m);
  else if(e.key==='ArrowRight') go(1);
  else if(e.key==='ArrowLeft') go(-1);
});
render();
</script>

</body></html>
