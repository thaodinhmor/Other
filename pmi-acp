<style>
/* Layout: phiếu trả lời trắc nghiệm — cột câu hỏi + bảng số câu (OMR), giải thích mở ngay dưới đáp án */
:root{
  --bg:#eef1f4; --paper:#ffffff; --ink:#1b2430; --muted:#5d6876; --line:#d7dde4;
  --accent:#1d5a86; --accent-soft:#e3edf5;
  --ok:#1f7a4d; --ok-soft:#e2f2e9; --bad:#b33a2e; --bad-soft:#f8e4e1; --note:#8a5a00; --note-soft:#fbf0d6;
  --f-body:"Be Vietnam Pro",system-ui,-apple-system,"Segoe UI",sans-serif;
  --f-mono:"IBM Plex Mono",ui-monospace,Menlo,Consolas,monospace;
}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){
  --bg:#12171d; --paper:#1a2129; --ink:#e5eaf0; --muted:#98a3b0; --line:#2c3642;
  --accent:#7fb6e0; --accent-soft:#1f3243;
  --ok:#5cc792; --ok-soft:#173327; --bad:#ef8a7e; --bad-soft:#3a1f1c; --note:#e8b85a; --note-soft:#34290f;
  color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#12171d; --paper:#1a2129; --ink:#e5eaf0; --muted:#98a3b0; --line:#2c3642;
  --accent:#7fb6e0; --accent-soft:#1f3243;
  --ok:#5cc792; --ok-soft:#173327; --bad:#ef8a7e; --bad-soft:#3a1f1c; --note:#e8b85a; --note-soft:#34290f;
  color-scheme:dark}
*{box-sizing:border-box}
body{background:var(--bg);color:var(--ink);font-family:var(--f-body);font-size:15px;line-height:1.6;
  padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));padding-block:20px 48px}
.wrap{max-width:1120px;margin:0 auto;display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:24px;align-items:start}
header{grid-column:1/-1;display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:12px 24px}
h1{font-size:26px;line-height:1.2;font-weight:800;margin:0;letter-spacing:-.01em;text-wrap:balance}
.sub{color:var(--muted);margin:4px 0 0;font-size:14px}
.stats{display:flex;gap:18px;font-family:var(--f-mono);font-variant-numeric:tabular-nums;font-size:13px}
.stats b{display:block;font-size:20px;font-family:var(--f-mono)}
.stats .s-ok b{color:var(--ok)} .stats .s-bad b{color:var(--bad)}
.stats span{color:var(--muted)}
.card{background:var(--paper);border:1px solid var(--line);border-radius:10px;padding:24px;min-width:0}
.qmeta{display:flex;flex-wrap:wrap;gap:8px 12px;align-items:center;justify-content:space-between;margin-bottom:12px}
.qno{font-family:var(--f-mono);font-size:13px;color:var(--accent);font-weight:600;letter-spacing:.04em;text-transform:uppercase}
.pos{font-family:var(--f-mono);font-size:12px;color:var(--muted)}
.stem{font-size:17px;line-height:1.65;font-weight:500;margin:0 0 18px;white-space:pre-line}
.opts{display:grid;gap:10px}
.opt{display:grid;grid-template-columns:32px minmax(0,1fr);gap:12px;align-items:start;text-align:left;width:100%;
  font:inherit;color:inherit;background:transparent;border:1px solid var(--line);border-radius:8px;padding:12px 14px;cursor:pointer;transition:border-color .15s,background .15s}
.opt:hover:not(:disabled){border-color:var(--accent);background:var(--accent-soft)}
.opt:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.opt:disabled{cursor:default}
.bub{width:30px;height:30px;border-radius:50%;border:1.5px solid var(--muted);display:grid;place-items:center;font-family:var(--f-mono);font-weight:600;font-size:13px;color:var(--muted)}
.opt.correct{border-color:var(--ok);background:var(--ok-soft)}
.opt.correct .bub{background:var(--ok);border-color:var(--ok);color:var(--paper)}
.opt.wrong{border-color:var(--bad);background:var(--bad-soft)}
.opt.wrong .bub{background:var(--bad);border-color:var(--bad);color:var(--paper)}
.opt.dim{opacity:.62}
.verdict{margin-top:18px;font-weight:700;font-size:16px}
.verdict.ok{color:var(--ok)} .verdict.bad{color:var(--bad)}
.exp{margin-top:10px;border-top:1px solid var(--line);padding-top:14px;display:grid;gap:14px}
.exp h3{margin:0 0 4px;font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);font-weight:700}
.exp p{margin:0;max-width:70ch}
.wrongs{list-style:none;margin:0;padding:0;display:grid;gap:6px}
.wrongs li{display:grid;grid-template-columns:24px minmax(0,1fr);gap:8px}
.wrongs .l{font-family:var(--f-mono);font-weight:600;color:var(--bad)}
.tip{background:var(--accent-soft);border-radius:8px;padding:10px 14px}
.tip h3{color:var(--accent)}
.note{background:var(--note-soft);border-radius:8px;padding:10px 14px}
.note h3{color:var(--note)}
.nav{display:flex;gap:10px;justify-content:space-between;margin-top:22px;flex-wrap:wrap}
.btn{font:inherit;font-weight:600;font-size:14px;border-radius:8px;padding:9px 16px;cursor:pointer;border:1px solid var(--line);background:var(--paper);color:var(--ink)}
.btn:hover{border-color:var(--accent)}
.btn.primary{background:var(--accent);border-color:var(--accent);color:var(--paper)}
.btn:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.btn:disabled{opacity:.4;cursor:default}
.keys{color:var(--muted);font-size:12px;margin-top:14px}
.keys kbd{font-family:var(--f-mono);font-size:11px;border:1px solid var(--line);border-radius:4px;padding:0 5px}
aside{position:sticky;top:16px;display:grid;gap:16px}
aside h2{font-size:13px;letter-spacing:.06em;text-transform:uppercase;margin:0 0 10px;color:var(--muted)}
.filters{display:flex;flex-wrap:wrap;gap:6px}
.chip{font:inherit;font-size:13px;border:1px solid var(--line);background:transparent;color:var(--ink);border-radius:999px;padding:4px 11px;cursor:pointer}
.chip[aria-pressed="true"]{background:var(--ink);color:var(--paper);border-color:var(--ink)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(38px,1fr));gap:5px;max-height:52vh;overflow:auto;padding:2px}
.cell{font-family:var(--f-mono);font-size:12px;font-variant-numeric:tabular-nums;border:1px solid var(--line);background:transparent;color:var(--ink);border-radius:6px;height:32px;cursor:pointer}
.cell.ok{background:var(--ok-soft);border-color:var(--ok);color:var(--ok)}
.cell.bad{background:var(--bad-soft);border-color:var(--bad);color:var(--bad)}
.cell.cur{outline:2px solid var(--accent);outline-offset:1px}
.tools{display:flex;flex-wrap:wrap;gap:8px}
.confirm{font-size:13px;display:flex;flex-wrap:wrap;gap:8px;align-items:center}
.empty{color:var(--muted)}
.bar{height:6px;background:var(--line);border-radius:3px;overflow:hidden;margin-top:10px}
.bar i{display:block;height:100%;background:var(--accent);width:0;transition:width .3s}
@media (max-width:860px){.wrap{grid-template-columns:minmax(0,1fr)} aside{position:static;order:-1} .grid{max-height:180px}}
@media (max-width:480px){.card{padding:16px}.stem{font-size:16px}}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
</style>

<div class="wrap">
  <header>
    <div>
      <h1>Đề ôn PMI-ACP</h1>
      <p class="sub"><span id="total"></span> câu trắc nghiệm · chọn đáp án để xem kết quả và giải thích tiếng Việt</p>
